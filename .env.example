# Runtime database role; db:runtime:prepare generates its private password.
# Migration administration uses the separate private .env.migrate file.
DATABASE_URL=postgresql://bitovp_runtime@localhost:5432/bitovp
COMPOSE_DATABASE_URL=postgresql://bitovp_runtime@postgres:5432/bitovp
REDIS_URL=redis://localhost:6379

# Immutable worker image reference for Live verification evidence.
VERIFY_LIVE_EVIDENCE_IMAGE=

# Verification signing key identifier and private JSON keyring.
VERIFY_SEAL_KEY_ID=
VERIFY_SEAL_KEYS=
VERIFY_RELEASE_MODE=

# Signed verification evidence lifetime in days (default 90).
VERIFY_EVIDENCE_RETENTION_DAYS=

# Encryption key for stored credentials: openssl rand -base64 32
MASTER_KEY=

# Optional webhook signing master secret; otherwise generated and stored encrypted.
BITMOVIN_WEBHOOK_SECRET=

# Externally reachable application origin for webhook registration.
PUBLIC_BASE_URL=http://localhost:3100

# static, quick-tunnel, named-tunnel, or none; quick-tunnel publishes webhook routes.
INGRESS_MODE=quick-tunnel

# Compose profile matching the selected tunnel mode.
COMPOSE_PROFILES=quick-tunnel

# Named tunnel hostname without a URL scheme.
INGRESS_HOSTNAME=

# Optional quick-tunnel discovery endpoint override.
INGRESS_QUICKTUNNEL_METRICS_URL=

# Optional tunnel forwarding URL override.
INGRESS_ORIGIN_URL=

# Private Cloudflare token for named tunnels only.
TUNNEL_TOKEN=

# Comma-separated hosts permitted to receive stored credentials; blank is unrestricted.
SECRET_EGRESS_ALLOWED_HOSTS=

# password (default), users, or explicit local-only none. Missing password configuration locks access.
AUTH_MODE=

# Generate the shared password hash: pnpm --filter @bitovp/web auth:hash
AUTH_PASSWORD_HASH=

# Session signing secret: openssl rand -base64 48
AUTH_SESSION_SECRET=

# Optional idle minutes (default 720) and maximum session hours (default 168).
AUTH_SESSION_IDLE_MINUTES=
AUTH_SESSION_MAX_HOURS=

# Trusted reverse-proxy depth; leave blank when connecting directly.
TRUSTED_PROXY_HOPS=

# Leave blank for the supported UNRESTRICTED deployment profile.
DEPLOYMENT_PROFILE=

# Live heartbeat push interval in seconds; off disables registration.
HEARTBEAT_WEBHOOK_INTERVAL_S=20

# Optional host ports for running a separate local deployment.
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3100
INGRESS_METRICS_PORT=20241

# Web memory ceiling (1g = 1 GiB); additional swap is disabled.
WEB_MEMORY_LIMIT=1g
