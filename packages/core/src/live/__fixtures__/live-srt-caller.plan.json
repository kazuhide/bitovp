{
	"planVersion": 1,
	"name": "Live SRT Caller Channel (live-srt-caller)",
	"bitmovin": {
		"cloudRegion": "AWS_AP_NORTHEAST_1",
		"encoderVersion": "STABLE"
	},
	"liveInput": {
		"key": "main",
		"kind": "SRT",
		"name": "SRT Caller Input",
		"mode": "CALLER",
		"host": "203.0.113.10",
		"port": 7000,
		"latency": 150,
		"credentialId": "00000000-0000-4000-8000-000000000003",
		"keyLength": 256
	},
	"outputs": [
		{
			"key": "origin",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucket": "sample-output-bucket",
			"name": "Test S3 Output"
		}
	],
	"ingest": [
		{
			"key": "video",
			"inputPath": "/",
			"position": 0
		},
		{
			"key": "audio",
			"inputPath": "/",
			"position": 1
		}
	],
	"renditions": [
		{
			"key": "v720",
			"codec": "H264",
			"name": "Live H264 720p",
			"ingestKey": "video",
			"height": 720,
			"bitrate": 3000000,
			"level": null,
			"presetConfiguration": "LIVE_STANDARD",
			"mode": "STANDARD"
		},
		{
			"key": "a128",
			"codec": "AAC",
			"ingestKey": "audio",
			"bitrate": 128000,
			"rate": 48000,
			"channelLayout": "CL_STEREO"
		}
	],
	"muxings": [
		{
			"key": "v720",
			"kind": "FMP4",
			"streamKey": "v720",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-srt-caller/video/720p"
			}
		},
		{
			"key": "a128",
			"kind": "FMP4",
			"streamKey": "a128",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-srt-caller/audio/128000"
			}
		}
	],
	"liveManifests": [
		{
			"key": "hls",
			"kind": "HLS",
			"manifestName": "stream.m3u8",
			"name": "Live HLS Manifest",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-srt-caller"
			},
			"audioGroupId": "audio",
			"audioLanguage": "en",
			"closedCaptions": "NONE",
			"timeshift": 3600
		}
	],
	"start": {
		"streamKey": "srtCallerKey",
		"liveEncodingMode": "SINGLE_PASS",
		"reupload": {
			"muxingInitFileInterval": 300
		}
	}
}
