/// CONTRACT: rows with signatureValid=false are diagnostics-only and MUST
/// NOT drive state — the receiver is a public endpoint and anyone can
/// produce unverified rows. Consumers go through
/// findProcessableWebhookEvents (packages/db), which filters to verified.
model WebhookEvent {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id              String    @id @default(uuid()) @db.Uuid
  source          String    @default("bitmovin")
  eventType       String?
  /// Provider-side event/notification id — dedupes webhook redeliveries.
  /// Only VERIFIED deliveries may claim a slot (set null on unverified
  /// rows), so spam can never mask a future genuine delivery.
  externalEventId String?   @unique
  /// Verified receiver identity for deferred heartbeat binding; never body-supplied.
  receiverTokenHash String?
  raw             Json
  signatureValid  Boolean
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  /// WP-G G-2: which job / run the `j`-scope token that received this
  /// delivery was registered for — resolved from the WebhookRegistration
  /// row, never from the body. Plain ids, no foreign key: a delivery is a
  /// record of what arrived and must outlive the job's deletion.
  encodingJobId    String? @db.Uuid
  liveChannelRunId String? @db.Uuid

  @@index([receivedAt(sort: Desc)])
  @@index([eventType])
  @@index([processedAt])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// WP-G G-2 — one row per (encoding, kind) the app registered with Bitmovin
/// through `createByEncodingId`, plus the rows that COULD NOT be registered
/// (SKIPPED: no public ingress; FAILED: provider error, retried with
/// backoff). The worker's registrar reconciles this table against the jobs
/// and runs every 10 s: registers when an encoding id exists and the job is
/// live, deletes at the provider when the job is terminal or gone, and
/// re-registers when the persisted ingress moved. `url` carries the receiver
/// token in plain sight (it is what Bitmovin stores); `tokenHash` is the
/// receiver's lookup key; the HMAC key is never stored — it is derived.
enum WebhookRegistrationStatus {
  ACTIVE
  SKIPPED
  FAILED
  DELETED
}

model WebhookRegistration {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                String                    @id @default(uuid()) @db.Uuid
  /// `j` = encoding events; `hb` = account or per-encoding heartbeat.
  scope             String                    @default("j")
  encodingJobId     String?                   @db.Uuid
  encodingJob       EncodingJob?              @relation(fields: [encodingJobId], references: [id], onDelete: SetNull)
  liveChannelRunId  String?                   @db.Uuid
  liveChannelRun    LiveChannelRun?           @relation(fields: [liveChannelRunId], references: [id], onDelete: SetNull)
  /// Denormalized so the provider-side delete still works after the job or
  /// run row is gone (SetNull above) — the registration must be removable
  /// by what THIS row knows.
  bitmovinAccountId String                    @db.Uuid
  encodingId        String
  /// finished | error | transferError | liveManifestReady, or liveEncodingHeartbeat for an `hb` row
  kind              String
  status            WebhookRegistrationStatus @default(SKIPPED)
  providerWebhookId String?
  /// Frozen heartbeat capability/correlation intent; null is legacy.
  configuration     Json?
  url               String?
  tokenHash         String?
  /// Fingerprint of the master secret the key was derived from; a rotated
  /// master makes every older row visibly stale and re-registered.
  keyId             String?
  /// Why the row is SKIPPED / FAILED (ingressUnavailable, provider:<msg>).
  note              String?
  attempts          Int                       @default(0)
  /// Backoff only: the next time the reconciler may touch this row.
  nextAttemptAt     DateTime?
  /// A worker's in-flight claim on the provider call (CAS window). Kept apart
  /// from `nextAttemptAt` so clearing a backoff (Settings → re-register) can
  /// never release another worker's claim and orphan a hook at Bitmovin.
  claimedUntil      DateTime?
  registeredAt      DateTime?
  deletedAt         DateTime?
  lastDeliveryAt    DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([encodingId, kind])
  @@index([tokenHash])
  @@index([status])
  @@index([encodingJobId])
  @@index([liveChannelRunId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

model AuditLog {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                String           @id @default(uuid()) @db.Uuid
  /// Who acted: `token:<id>` for API tokens (ledger #81); `user:<id>` once
