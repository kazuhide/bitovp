// Application persistence schema.
// Secrets are NEVER stored in plaintext: encrypted* columns hold serialized
// EncryptedSecret blobs (AES-256-GCM, AAD-bound to the owning row id) produced
// by @bitovp/core crypto. Snapshot columns exist because Bitmovin purges
// encoding data after ~90 days (constraint C7).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Credentials & accounts
// ---------------------------------------------------------------------------

/// Storage provider of a credential. Akamai (Linode) Object Storage and OCI
/// Object Storage are S3-compatible and become Bitmovin GenericS3 resources
/// with V4 signing (constraint C10); they get distinct values so the UI can
/// prefill host patterns.
enum CredentialProvider {
  AWS_S3
  AWS_S3_ROLE_BASED
  AKAMAI_OBJECT_STORAGE
  OCI_OBJECT_STORAGE
  GENERIC_S3
  GCS_HMAC
  GCS_SERVICE_ACCOUNT
  AZURE_BLOB
  SFTP
  AKAMAI_NETSTORAGE
  AKAMAI_MSL
  LIVE_MEDIA_INGEST
  DRM_CENC
  DRM_SPEKE
  NEXGUARD
  SRT_PASSPHRASE
  ZIXI
  POIS_ENDPOINT
  KANTAR
  NOTIFICATION_WEBHOOK
}

/// App-wide operator settings, one row per key (ledger #131).
/// Key/value rather than a column per knob: P11 and the cost/index work have
/// more knobs coming, and a column each means a migration each. The VALUE is
/// zod-validated in packages/core — an unparseable row degrades to DEFAULTS
/// rather than crashing a render. Defaults live in core, not here, so an
/// ABSENT row and a fresh install behave identically (no seed step).
model AppSetting {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([organizationId, key])
  @@index([organizationId])
}

model Credential {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id              String             @id @default(uuid()) @db.Uuid
  label           String
  provider        CredentialProvider
  /// Non-secret configuration: region, endpoint host, default bucket, etc.
  config          Json               @default("{}")
  /// Serialized EncryptedSecret (AES-256-GCM, AAD "credential:<id>").
  encryptedSecret String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  locationPresets      StorageLocationPreset[]
  inspections          StorageInspection[]
  notificationChannels NotificationChannel[]

  watchRules WatchRule[]

  @@index([provider])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Internal work ownership, not customer history. No foreign keys: survives reset.
model ResetCleanupTask {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id               String   @id @default(uuid()) @db.Uuid
  encryptedPayload String
  entityKeys       String[]
  revision         Int      @default(0)
  nextAttemptAt    DateTime @default(now())
  settledAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([entityKeys], type: Gin)
  @@index([settledAt, nextAttemptAt])

  @@unique([organizationId, id])
  @@index([organizationId])
}

model BitmovinAccount {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id              String   @id @default(uuid()) @db.Uuid
  label           String
  /// Serialized EncryptedSecret (AES-256-GCM, AAD "bitmovin-account:<id>").
  encryptedApiKey String
  /// Optional X-Tenant-Org-Id sent with every API call.
  tenantOrgId     String?
  /// Defaults applied to new plans: encoderVersion, cloudRegion,
  /// fallbackRegions, schedulingPriority, prewarmedPoolIds.
  defaults        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  encodingJobs     EncodingJob[]
  liveChannels     LiveChannel[]
  auditLogs        AuditLog[]
  verificationRuns VerificationRun[]
  usageDailyStatistics UsageDailyStatistic[]
  usageSweepCursors    UsageSweepCursor[]

  @@unique([organizationId, id])
  @@index([organizationId])
}

enum StorageRole {
  INPUT
  OUTPUT
}

model StorageLocationPreset {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id           String      @id @default(uuid()) @db.Uuid
  credentialId String      @db.Uuid
  credential   Credential  @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  label        String
  bucket       String
  prefix       String      @default("")
  role         StorageRole
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([credentialId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// VOD jobs
// ---------------------------------------------------------------------------

/// Orchestration status of an EncodingJob (our state machine, not Bitmovin's;
/// the raw Bitmovin status lives in snapshots/stepLog).
///
/// AWAITING_QC / QC_FAILED (ledger #86 PR2): a BLOCK_MANIFESTS gate parks the
/// job at AWAITING_QC once encoding finishes (deferred manifest steps stay
/// PENDING); the vmaf-runner's continuation re-enqueues it, and the verdict
/// decides FINISHED (gate passed, manifests generated) or QC_FAILED. QC_FAILED
/// is deliberately NOT ERROR — a correct measurement of a bad encode is not a
/// malfunction (the #42 lesson), and the retry route must keep refusing it
/// (override-and-deliver is its own audited action, PR4).
/// Declaration order = PHYSICAL order (review-201 N1): ALTER TYPE ADD VALUE
/// appends, so the two #86 values sit at the END here even though they read
/// better beside RUNNING — every prior enum addition kept this property and
/// the first divergence is not worth a special case.
enum EncodingJobStatus {
  DRAFT
  QUEUED
  RUNNING
  FINISHED
  ERROR
  CANCELED
  AWAITING_QC
  QC_FAILED
}

model EncodingJob {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                 String            @id @default(uuid()) @db.Uuid
  name               String
  labels             String[]          @default([])
  status             EncodingJobStatus @default(DRAFT)
  /// Explicit library reset keeps job history without automatic re-registration.
  /// Cleared only by a successful explicit capture under the job row lock.
  libraryCaptureSuppressed Boolean @default(false)
  /// Denormalized list-view columns: plan/stepLog are NEVER selected in list
  /// queries (schema contract below), so the run region (plan.bitmovin.
  /// cloudRegion) and step progress (count of DONE stepLog entries) are
  /// projected into columns at creation and bumped by the orchestrator after
  /// each step. region is null and totalSteps 0 for jobs created before this
  /// migration → the UI must treat totalSteps=0 as "progress unknown".
  region             String?
  doneSteps          Int               @default(0)
  totalSteps         Int               @default(0)
  /// EncodingPlan JSON (zod-validated in packages/core before persisting).
  plan               Json
  /// Ordered step log: [{ step, requestedAt, request, response, resourceId }].
  /// CONTRACT: payloads MUST pass through redactSecrets before persisting
  /// (secrets are reconstructable from Credential rows at execution time).
  /// Single writer: only the orchestrator worker appends, one job = one
  /// BullMQ job; list endpoints must project columns (never select plan/
  /// stepLog/snapshots in list queries).
  stepLog            Json              @default("[]")
  bitmovinEncodingId String?           @unique
  /// Row #313: exact encoding id confirmed terminal or CREATED (never started),
  /// or verified absent by reset-only account/provenance checks and locked CAS.
  /// Exempts only the current bitmovinEncodingId; every (re)start clears it.
  /// Unknown/ambiguous reads remain blocking. Absence never changes lifecycle.
  encoderStoppedConfirmedFor String?
  /// Irreversible orphan STOP intent, not proof the provider stopped. Retry
  /// must not reuse this job's resources once set; re-run-as-new starts clear.
  /// Never expired with the attempt lease or cleared by reconciliation.
  remoteStopRequestedAt DateTime?
  bitmovinAccountId  String?           @db.Uuid
  bitmovinAccount    BitmovinAccount?  @relation(fields: [bitmovinAccountId], references: [id], onDelete: SetNull)
  /// Cooperative-cancel flag (ledger #10). The cancel route SETS it (atomic
  /// claim on QUEUED|RUNNING); the orchestrator worker — the SINGLE writer of
  /// `status` — re-reads it at safe points (loop top + before each step + each
  /// AWAIT_ENCODING poll) and honors it by transitioning the job to CANCELED
  /// (NEVER ERROR). Re-read from the DB each loop, so crash-resume re-honors it
  /// idempotently. The route never touches `status`; the worker owns the
  /// terminal transition, which is why a genuinely-FINISHED job is never reverted.
  /// Lease held by the worker attempt currently running this job.
  /// The VOD twin of `LiveChannel.provisionClaimedAt`.
  ///
  /// The status alone could not be the lock: a worker whose BullMQ lock lapsed
  /// mid-provider-call kept running while the redelivered job started on a
  /// second worker, and every step-log write was an unconditional update — so
  /// two attempts created at the provider and the last DB writer won. CONTRACT:
  /// the orchestrator claims this atomically (null or stale → now) before its
  /// first write, RENEWS it on every poll tick, FENCES every persist on the
  /// value it last wrote, and RELEASES it (null) on any write that leaves the
  /// attempt — terminal, parked at AWAITING_QC, or canceled — so a retry or a
  /// QC continuation can claim at once. A timestamp rather than an owner token
  /// so a dead worker's claim simply expires.
  attemptClaimedAt   DateTime?
  cancelRequested    Boolean           @default(false)
  /// Full request/response snapshots for the bm-xray-style detail view (C7).
  /// CONTRACT: MUST pass through redactSecrets before persisting.
  snapshots          Json?
  /// QC gate verdict (ledger #86 PR2), denormalized from VmafJob.gateVerdict
  /// for the jobs list. CONTRACT: written by the vmaf-runner in the SAME
  /// transaction as gateVerdict — its one writer, and NOT a status write (the
  /// orchestrator stays the single writer of `status`/`stepLog`). Shape:
  /// QcVerdict from packages/core (pass + ruleResults). Null = no gate, or
  /// the measurement never completed.
  qcVerdict          Json?
  /// Override-and-deliver (ledger #86 PR4): when set, the QC boundary runs
  /// the deferred manifest group DESPITE a failing verdict. Written once by
  /// the override route's atomic QC_FAILED→QUEUED claim (audited there);
  /// the evidence report states it — a forced delivery is never silent.
  qcOverriddenAt     DateTime?
  error              String?
  /// The moment the orchestrator's SINGLE terminal transition wrote FINISHED
  /// (review-259 116-A1). `updatedAt` is NOT that moment: it is @updatedAt,
  /// bumped by any later write — a MARK_ONLY VMAF verdict landing after the
  /// run, a snapshot backfill (see step-log.ts's raw-SQL dodge of this exact
  /// column) — so durations derived from it inflate. Rows FINISHED before the
  /// migration carry updatedAt as a stated approximation (backfill).
  finishedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  /// Ledger #32 §5: the actor that created this job. Values track AUTH_MODE:
  /// `user:<id>` / `token:<id>` in users mode, the literal `session` in the
  /// DEFAULT shared-password mode, `none` under AUTH_MODE=none, and
  /// `worker:<name>` for the unattended watch sweep. Additive, nullable; old
  /// rows stay null. Same encoding as AuditLog.actor.
  createdBy          String?

  /// The plan is copied at launch. Deleting its template clears the relation
  /// while preserving presetRevision for the original template attribution.
  presetId       String? @db.Uuid
  preset         Preset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  presetRevision Int?

  /// The verification harness's idempotency
  /// key, stamped at create when the submit carried one. Unique, nullable:
  /// ordinary jobs never carry it. `POST /api/encoding-jobs` returns THIS row
  /// for a repeat of the same key with the same `verificationRequestSha256`
  /// and 409s a repeat with a different one — so a harness whose create
  /// response was lost can find the job it paid for instead of creating a twin.
  verificationKey           String? @unique
  verificationRequestSha256 String?

  manifests ManifestJob[]
  vmafJobs  VmafJob[]
  librarySources LibrarySource[]

  watchedObjects WatchedObject[]
  webhookRegistrations WebhookRegistration[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([finishedAt(sort: Desc)])
  @@index([bitmovinAccountId])
  @@index([presetId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Immutable VOD source snapshot plus a durable, leased analysis-import request.
/// The optional job link is navigation only; origin IDs and snapshot survive reset.
model LibrarySource {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id             String @id @default(uuid()) @db.Uuid
  sourceKey      String @unique
  jobId          String? @db.Uuid
  job            EncodingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  originalJobId  String @db.Uuid
  encodingId     String
  accountId      String @db.Uuid
  snapshot       Json
  locales        String[]
  state          String @default("PENDING")
  attempts       Int @default(0)
  availableAt    DateTime @default(now())
  leaseToken     String?
  leaseUntil     DateTime?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  analyses       SceneAnalysisRevision[]
  revisions      ContentRevision[]
  @@index([state, availableAt])
  @@index([jobId])
  @@index([originalJobId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Raw and normalized provider output are immutable and shared by job/Library.
model SceneAnalysisRevision {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id              String @id @default(uuid()) @db.Uuid
  sourceId        String @db.Uuid
  source          LibrarySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  locale          String
  rawHash         String
  providerVersion String
  raw             Json
  document        Json
  createdAt       DateTime @default(now())
  @@unique([sourceId, locale, rawHash])
  @@index([sourceId, locale, createdAt])

  @@unique([organizationId, id])
  @@index([organizationId])
}

model Content {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id              String @id @default(uuid()) @db.Uuid
  registrationKey String @unique
  title           String
  description     String @default("")
  tags            String[]
  locale          String
  revision        Int @default(1)
  archived        Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  revisions       ContentRevision[]
  @@index([archived, updatedAt])

  @@unique([organizationId, id])
  @@index([organizationId])
}

model ContentRevision {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id          String @id @default(uuid()) @db.Uuid
  contentId   String @db.Uuid
  content     Content @relation(fields: [contentId], references: [id], onDelete: Restrict)
  revision    Int
  sourceId    String @db.Uuid
  source      LibrarySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  title       String
  description String
  tags        String[]
  locale      String
  createdBy   String?
  createdAt   DateTime @default(now())
  @@unique([contentId, revision])
  @@index([sourceId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

enum ManifestType {
  HLS
  DASH
}

enum ManifestMode {
  DEFAULT
  CUSTOM
}

/// C1: Per-Title + CUSTOM manifests must use POST_ENCODING.
enum ManifestGeneration {
  JUST_IN_TIME
  POST_ENCODING
}

enum ManifestJobStatus {
  PENDING
  RUNNING
  FINISHED
  ERROR
}

model ManifestJob {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                 String             @id @default(uuid()) @db.Uuid
  encodingJobId      String             @db.Uuid
  encodingJob        EncodingJob        @relation(fields: [encodingJobId], references: [id], onDelete: Cascade)
  type               ManifestType
  mode               ManifestMode
  generation         ManifestGeneration
  status             ManifestJobStatus  @default(PENDING)
  bitmovinManifestId String?
  snapshot           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([encodingJobId])
  @@index([bitmovinManifestId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Live
// ---------------------------------------------------------------------------

/// Orchestration status of a LiveChannel (our state machine, not
/// Bitmovin's). Unlike EncodingJob, RUNNING is the STEADY state (the
/// channel stays up until stopped); PROVISIONING covers the compiled
/// step-log replay up to AWAIT_LIVE_RUNNING.
enum LiveChannelStatus {
  CREATED
  PROVISIONING
  RUNNING
  STOPPING
  STOPPED
  ERROR
}

model LiveChannel {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                 String            @id @default(uuid()) @db.Uuid
  name               String
  status             LiveChannelStatus @default(CREATED)
  /// The monotonic CAS authority shared by run
  /// transitions and external-effect claims. Every claim and every stop/start
  /// transition increments it; an effect may send only while its committed
  /// claim generation is still current.
  liveEffectFenceVersion Int           @default(0)
  /// Ledger #160 PR4: startup probes ride the NORMAL pipeline but are
  /// not operator content — PROBE rows are hidden from the default
  /// channel list (a toggle reveals them) and their finalize sample
  /// records source PROBE. Null = an ordinary channel.
  purpose            String?
  /// LiveChannelPlan JSON (zod-parsed in packages/core before persisting).
  plan               Json
  /// Ordered provisioning step log — same contract as EncodingJob.stepLog:
  /// redacted snapshots only, single writer (the live-channel worker), the
  /// worker replays THIS (never recompiles). The AWAIT_LIVE_RUNNING entry
  /// additionally carries the C7 start-request snapshot (getLiveStartRequest)
  /// and live details, redacted.
  stepLog            Json              @default("[]")
  /// Lease held by the worker currently provisioning this channel.
  ///
  /// The status alone could not be the lock. `provision()` accepts CREATED
  /// (the create route's own enqueue) AND PROVISIONING (a start action that
  /// atomically claimed the row), so when a start arrived while the row was
  /// still CREATED, BOTH jobs passed the guard and ran every op — two encoding
  /// trees writing the same output prefix, both billed.
  /// The start action's claim was correct; it
  /// just never stopped the create path's job.
  ///
  /// A TIMESTAMP rather than an owner token, so a worker that dies mid-provision
  /// does not wedge the channel forever: the lease simply goes stale and the
  /// next attempt takes it. That keeps the three existing stale-PROVISIONING
  /// recovery paths (worker index sweep, reconcile-stranded-runs, startup
  /// sample) unchanged rather than adding a fourth thing they must remember to
  /// release.
  provisionClaimedAt DateTime?
  bitmovinEncodingId String?           @unique
  /// Row #313: exact encoding id confirmed terminal or CREATED (never started),
  /// or verified absent by reset-only account/provenance checks and locked CAS.
  /// Exempts only the current bitmovinEncodingId; every (re)start clears it.
  /// Unknown/ambiguous reads remain blocking. Absence never changes lifecycle.
  encoderStoppedConfirmedFor String?
  bitmovinAccountId  String?           @db.Uuid
  bitmovinAccount    BitmovinAccount?  @relation(fields: [bitmovinAccountId], references: [id], onDelete: SetNull)
  /// Live encoder ingest coordinates from LiveEncoding (live get). The
  /// stream key column is the ONE structural redaction exception (COVERAGE
  /// P3 batch 1): it is connection-routing material the user must read back
  /// to point an encoder; redactSecrets still masks streamKey fields inside
  /// persisted JSON snapshots/step logs.
  streamKey          String?
  encoderIp          String?
  /// Latest heartbeat poll: { at, raw, deltas } — the SDK packet counters
  /// are CUMULATIVE since encoding start, so the worker stores the raw
  /// sample plus per-poll deltas. This is the CURRENT-STATE column the
  /// detail panel reads; the per-poll HISTORY (the dashboard trend chart)
  /// lives in the LiveHeartbeat time-series table below, appended by the
  /// same sweep and pruned to a retention window.
  lastHeartbeat      Json?
  /// live-to-VOD result (P5): Bitmovin has no live-to-VOD API, so this is
  /// OUR record of the workflow — { status: RUNNING|FINISHED|ERROR,
  /// requestedAt, finishedAt?, outputId, path, manifests: [{ type, manifestId,
  /// url }], error? } — generated by creating DEFAULT VOD manifests over this
  /// channel's own (stopped) encoding with manifestGenerator LEGACY. Written
  /// only by the channel worker; the route just claims the RUNNING state so a
  /// double-submit cannot start two runs.
  liveToVod          Json?
  error              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  /// Ledger #32 §5: creating actor — user:<id> / token:<id> in users mode,
  /// `session` in shared-password mode, `none` under AUTH_MODE=none,
  /// worker:<name> for the runner (a probe stamps worker:startup-probe).
  /// Additive, nullable.
  createdBy          String?

  /// Runtime cap (ledger #84): RUNNING longer than this many minutes =>
  /// the schedule sweep stops the channel, measured from runningSince.
  maxRunMinutes  Int?
  /// Scheduled program window (ledger #94), from the creation-time slot.
  /// PROGRAM_START_NO_INGEST alerts only inside this window, and the detail
  /// timeline renders it.
  programStartAt DateTime?
  programEndAt   DateTime?
  /// Observed-RUNNING epoch (ledger #84, review-190 I6): set by the worker
  /// whenever it writes status RUNNING (provision finalize AND restart), so
  /// the cap never reads step logs and a restart starts a fresh epoch.
  runningSince   DateTime?

  /// Template provenance (ledger #109) — same pair, same semantics as
  /// EncodingJob.presetId/presetRevision (COPIED at launch, SetNull).
  presetId       String? @db.Uuid
  preset         Preset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  presetRevision Int?

  /// The verification harness's idempotency
  /// key — same contract as `EncodingJob.verificationKey`, honoured by
  /// `POST /api/live-channels`. A channel is billed from creation (ledger
  /// #125), which is exactly why a lost create response must be recoverable.
  verificationKey           String? @unique
  verificationRequestSha256 String?

  feederSessions FeederSession[]
  liveHeartbeats LiveHeartbeat[]
  /// Ledger #108: the channel's run history (1:N). At most one non-terminal
  /// run — enforced by a hand-written partial unique index in the migration
  /// (Prisma cannot express it; the #83 precedent).
  runs           LiveChannelRun[]
  schedules      LiveSchedule[]
  slateNormalizations SlateNormalization[]
  effectClaims   LiveEffectClaim[]
  alertRules     AlertRule[]
  alertEvents    AlertEvent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([bitmovinAccountId])
  @@index([presetId])
  /// review-pr34 Q6: the default channel list filters `purpose: null` and
  /// the probe reconciler scans `purpose: "PROBE"` — btree carries both.
  @@index([purpose])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// One Bitmovin encoding = one RUN of a channel (ledger #108 §2). The channel
/// outlives it: FINISHED releases the vendor's infrastructure and nothing
/// resurrects it (C30), so a re-air is a NEW run, never a restart. This PR
/// (#108 PR1) is schema+backfill+derivation only — the worker still writes
/// the channel columns; the run rows become the write path in the follow-up.
model LiveChannelRun {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                            String            @id @default(uuid()) @db.Uuid
  liveChannelId                 String            @db.Uuid
  liveChannel                   LiveChannel       @relation(fields: [liveChannelId], references: [id], onDelete: Cascade)
  /// Monotonic per channel, starting at one; displayed as the broadcast number.
  seq                           Int
  status                        LiveChannelStatus @default(CREATED)
  /// Durable cooperative startup cancellation; kept on the exact airing across retries.
  cancelRequested               Boolean           @default(false)
  /// Unique across ALL runs; null only until CREATE_ENCODING lands.
  bitmovinEncodingId            String?           @unique
  /// Row #313: exact encoding id confirmed terminal or CREATED (never started),
  /// or verified absent by reset-only account/provenance checks and locked CAS.
  /// Exempts only the current bitmovinEncodingId; every (re)start clears it.
  /// Unknown/ambiguous reads remain blocking. Absence never changes lifecycle.
  encoderStoppedConfirmedFor    String?
  /// The compiled step log for THIS run — replay/resume is per run.
  stepLog                       Json              @default("[]")
  /// Per-run ingest facts: Bitmovin allocates a fresh encoder per run.
  encoderIp                     String?
  streamKey                     String?
  /// Where this run's segments/manifests were written (§4):
  /// <channel base>/runs/<seq>-<runId8>/… — empty for backfilled run #1,
  /// which wrote at the plan's own paths before the rebase existed.
  outputPrefix                  String
  /// Ledger #160: Bitmovin queue/allocation seconds for THIS run's start
  /// (the AWAIT pair) — denormalized so lists and the Runs card never read
  /// the step log. Null until the run reaches RUNNING via provision.
  /// Ledger #161 §4 — the origin observer's per-RUN cursor (last fetch,
  /// due-at, per-playlist segment counts/URIs, last verdicts). On the RUN,
  /// not the channel: run 2's fresh manifest read against run 1's cursor
  /// would be a false CRIT at the top of the new airing (#108/#127/#155).
  originObservation             Json?
  /// Ledger #239 — the media attributes THIS run's encoder is bound to, as
  /// the first feeder push put them on the wire (`MediaAttributes`: video
  /// codec/size/frame rate/profile/level/pixel format + the audio streams).
  /// A live encoding binds its input format once and faults on a mid-run
  /// change, so a later feeder (a scheduled FEEDER_SWITCH, an operator's
  /// manual session) is compared against this before ffmpeg is spawned.
  /// On the RUN, not the channel, for the same reason `originObservation`
  /// is: a re-air provisions a FRESH encoder that binds whatever arrives
  /// next, and inheriting the previous airing's format would refuse a
  /// perfectly good first push. Written once per run (CAS on NULL) — the
  /// switch being checked must never redefine the reference it was checked
  /// against. Null = nothing recorded; the gate then falls back to the
  /// encoder's own heartbeat, or stands down.
  ingestMedia                   Json?
  /// The CAS lock for the column above, and the reason it is a separate
  /// DateTime rather than a filter on the Json itself: row #254 (the live-to-VOD sentinel finding, PR #349) measured
  /// `{ equals: Prisma.DbNull }` matching NOTHING against a SQL-NULL Json
  /// column in the deployed (bundled) web image while the same predicate
  /// matched from a plain process — the sentinel is an identity, and an
  /// identity does not survive every build. A first-writer-wins lock whose
  /// failure mode is "the reference is never recorded, silently" must not
  /// rest on that. `ingestMediaRecordedAt: null` is an ordinary IS NULL that
  /// no bundler can reinterpret. Written in the SAME update as ingestMedia,
  /// so the two can never disagree.
  ingestMediaRecordedAt         DateTime?
  queueSeconds                  Int?
  runningSince                  DateTime?
  endedAt                       DateTime?
  /// Snapshot of the window THIS run served (R6): the channel's own
  /// programStartAt/EndAt mean the UPCOMING window and get rewritten.
  programStartAt                DateTime?
  programEndAt                  DateTime?
  error                         String?
  liveToVod                     Json?
  lastHeartbeat                 Json?
  /// The HEARTBEAT_STALE anchor (ledger #108 PR2; review-109pr1's pre-build
  /// catch): ONLY the heartbeat mirror writes this. `updatedAt` moves on ANY
  /// row write (step-log mirrors, status transitions, encoder facts) and is
  /// NOT a sign of encoder life — anchoring staleness there lets unrelated
  /// writes silently reset the clock on a genuinely dead feed. Null = no
  /// sample this run; staleness grace then measures from createdAt, which is
  /// how a fresh run avoids inheriting the previous run's grace (R5/I3).
  lastHeartbeatAt               DateTime?
  /// The PROVIDER's own lifecycle word
  /// for THIS run's encoding — RUNNING / QUEUED / FINISHED / … as last read
  /// back from the encoding-status endpoint for exactly `bitmovinEncodingId`.
  /// Never inferred from a local write (a Restart 2xx, a details GET or a
  /// heartbeat that succeeded is not a lifecycle observation). Null until the
  /// first exact readback — existing rows are NOT backfilled by guess.
  providerStatus                String?
  /// When that successful readback happened. Readers treat a RUNNING older
  /// than the freshness TTL (core PROVIDER_STATUS_TTL_MS) as UNKNOWN.
  providerStatusObservedAt      DateTime?
  /// First failed/inconclusive readback (timeout, network/credential error,
  /// 404) since the last successful one. Null = confirmed, or never observed.
  /// Cleared by the next successful readback — the UNKNOWN window's start,
  /// which the grace alert and the customer strip both measure from.
  providerUnknownSince          DateTime?
  /// Set by the first sweep that reports an UNKNOWN window past grace.
  /// Cleared with the window so a later outage has its own transition.
  providerUnknownAlertedAt      DateTime?
  /// Stamped ONCE when a terminal provider status (FINISHED/ERROR/CANCELED/
  /// TRANSFER_ERROR) was reconciled onto this run. A run carrying this is
  /// never revived by Start nor restarted — the audited sequence reused a
  /// FINISHED encoding's id, ingest coordinates and DONE step log.
  providerTerminalAt            DateTime?
  /// Durable completion marker for the terminal run's feeder-stop intents.
  /// A terminal run may move its channel to ERROR even when Redis is briefly
  /// unavailable; the heartbeat sweep retries every still-null marker until
  /// all matching feeder stop jobs have been accepted.
  providerFeederStopsEnqueuedAt DateTime?
  /// Per-run heartbeat poll token: every sweep
  /// claim bumps it by compare-and-swap, and a poll result whose epoch no
  /// longer matches is discarded whole — no sample, no history, no alert.
  heartbeatPollEpoch            Int               @default(0)
  /// The run's heartbeat SUMMARY (core `RunHeartbeatSummary`): sample count,
  /// first/last poll, ingest-connected span, packet totals, provider event
  /// counts. Written ONCE by the sweep's summarizer after `endedAt` lands, so
  /// a run outlives its heartbeat rows (retention prunes them after 7 days).
  heartbeatSummary              Json?
  /// When the summary was computed — the write-once lock for the column
  /// above, a plain `IS NULL` for the same reason `ingestMediaRecordedAt` is
  /// (a Json-null sentinel is not a reliable predicate in every build). A
  /// revive clears it WITH `endedAt`, so a resumed airing is re-summarized
  /// when it finally ends.
  heartbeatSummaryAt            DateTime?
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  liveHeartbeats LiveHeartbeat[]
  feederSessions FeederSession[]
  webhookRegistrations WebhookRegistration[]

  @@unique([liveChannelId, seq])
  @@index([liveChannelId, createdAt(sort: Desc)])
  @@index([providerTerminalAt, providerFeederStopsEnqueuedAt])

  @@unique([organizationId, id])
  @@index([organizationId])
}

enum AlertSeverity {
  WARN
  CRIT
}

/// Live alert rule (ledger #83). Thresholds an operator can read — no
/// anomaly detection. Metric values are validated in core
/// (ALERT_METRICS); PACKET_DELTA_ZERO from the design is RESERVED, not
/// accepted: the heartbeat sample carries no received-packet counter, so
/// the metric cannot be computed honestly from the data we have.
model AlertRule {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id            String        @id @default(uuid()) @db.Uuid
  /// null ⇒ applies to ALL channels; else channel-scoped.
  liveChannelId String?       @db.Uuid
  liveChannel   LiveChannel?  @relation(fields: [liveChannelId], references: [id], onDelete: Cascade)
  metric        String
  /// Numeric rules only (BITRATE_BELOW / FPS_BELOW).
  threshold     Float?
  /// How many consecutive polls must breach before the alert opens.
  windowPolls   Int           @default(2)
  severity      AlertSeverity @default(WARN)
  enabled       Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  events AlertEvent[]

  @@index([liveChannelId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Open/resolve alert lifecycle (ledger #83). At most one OPEN event per
/// (rule, channel) — enforced by a PARTIAL UNIQUE INDEX in the migration
/// SQL (Prisma cannot express `WHERE "resolvedAt" IS NULL` declaratively;
/// the #14 triggerKey precedent). The DB, not a check-then-act read,
/// dedups racing opens; the loser treats P2002 as "already open".
model AlertEvent {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id            String      @id @default(uuid()) @db.Uuid
  ruleId        String      @db.Uuid
  rule          AlertRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  liveChannelId String      @db.Uuid
  liveChannel   LiveChannel @relation(fields: [liveChannelId], references: [id], onDelete: Cascade)
  openedAt      DateTime
  resolvedAt    DateTime?
  /// Snapshot of the breaching observation(s) — chart-linkable.
  context       Json

  @@index([liveChannelId, openedAt(sort: Desc)])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Per-poll heartbeat history — the time-series backing the dashboard trend
/// chart and the per-run heartbeat log. The 30s sweep appends ONE row per
/// poll ({ at, raw, deltas } — the same sample it also writes to
/// LiveChannel.lastHeartbeat) and prunes the channel's rows older than a
/// retention window (HEARTBEAT_RETENTION_MS, default 7 days ≈ 20k
/// rows/channel/week @30s, ~1.1 KB of raw JSON each — bounded, and pruned
/// in capped batches). Cascade-deleted with the channel. Same redaction
/// discipline as the column: the persisted JSON passes through
/// redactSecrets (the sample's rtmpUserIngestInfo.streamKey lands as
/// `[REDACTED]`).
model LiveHeartbeat {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id               String          @id @default(uuid()) @db.Uuid
  liveChannelId    String          @db.Uuid
  liveChannel      LiveChannel     @relation(fields: [liveChannelId], references: [id], onDelete: Cascade)
  /// Ledger #108: which RUN this sample belongs to. Nullable through the
  /// two-step move (backfilled for existing rows; required once the worker
  /// writes runs).
  liveChannelRunId String?         @db.Uuid
  liveChannelRun   LiveChannelRun? @relation(fields: [liveChannelRunId], references: [id], onDelete: Cascade)
  /// Poll time (ours) — the chart's x-axis; matches the sample's `at`.
  at               DateTime
  /// The raw cumulative SDK heartbeat sample (LiveHeartbeatSample), redacted.
  raw              Json
  /// Per-poll counter deltas (HeartbeatCounterDeltas) computed by the worker.
  deltas           Json
  createdAt        DateTime        @default(now())

  @@index([liveChannelId, at])
  /// review-293 I3: the run-health route filters by run — without this the
  /// query scans every channel's heartbeats per page poll.
  @@index([liveChannelRunId, at])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Pseudo-live feeder lifecycle (P3-PR3). CREATED → DOWNLOADING (source
/// spool) → PUSHING (supervised ffmpeg loop) → STOPPED; ERROR from any
/// stage. There is deliberately no STOPPING state: stop is handled
/// in-process by the supervisor (SIGTERM → grace → SIGKILL) and the worker
/// flips straight to STOPPED — the stop route therefore cannot claim a
/// transition and relies on worker-side idempotency instead.
enum FeederStatus {
  CREATED
  DOWNLOADING
  PUSHING
  STOPPED
  ERROR
}

/// Push protocol. SRT is CALLER mode only — the feeder dials Bitmovin's
/// SRT listener (the shared contract gotcha); listener-side SRT belongs to real
/// external feeds, not the feeder.
enum FeederProtocol {
  RTMP
  SRT_CALLER
}

model FeederSession {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                 String          @id @default(uuid()) @db.Uuid
  liveChannelId      String          @db.Uuid
  liveChannel        LiveChannel     @relation(fields: [liveChannelId], references: [id], onDelete: Cascade)
  /// Ledger #108: the run this feeder fed (nullable through the move).
  liveChannelRunId   String?         @db.Uuid
  liveChannelRun     LiveChannelRun? @relation(fields: [liveChannelRunId], references: [id], onDelete: Cascade)
  status             FeederStatus    @default(CREATED)
  /// Source MP4 storage coordinates; the credential is resolved from the
  /// vault at spawn only — never persisted here.
  sourceCredentialId String          @db.Uuid
  sourceBucket       String
  sourceKey          String
  /// Row #241 — the SEAL: which bytes the operator chose (audit 2026-08-29
  /// HIGH-4). bucket/key name a LOCATION, and a location is not a version:
  /// an object replaced under the same key between arm and air aired
  /// different content than the one that was scheduled, and nothing in this
  /// row could tell the two apart. Captured by `headObject` at ARM (or at
  /// creation for an immediate session) and DEMANDED at download —
  /// `getObject({ expect })` where the driver can express it, an observed-vs-
  /// sealed compare where it cannot.
  ///
  /// Verbatim, never normalized: S3 returns quoted ETags and wants the same
  /// quoted form back in `If-Match` (packages/storage `ObjectVersion`).
  /// All nullable — providers genuinely disagree about which they have, and
  /// rows written before this column carry nothing.
  sourceEtag         String?
  sourceVersionId    String?
  /// GCS's exact-version selector. Carried as a string because that is how
  /// the API returns it and how it round-trips through JSON; it is ALSO the
  /// only selector the GCS driver can enforce, so dropping it would make
  /// every GCS seal unenforceable.
  sourceGeneration   String?
  /// BigInt — mezzanines exceed Int32 (the `StorageInspection.objectSize`
  /// precedent). The transfer is asserted against it, so a truncated or
  /// swapped object fails the download instead of reaching the encoder.
  sourceSize         BigInt?
  /// SHA-256 of the bytes that were actually pushed, computed WHILE
  /// streaming to the spool (never a second read of the file). The audit
  /// trail: the seal proves we asked for the right version, this proves what
  /// arrived. Written when the download completes.
  sourceSha256       String?
  /// Row #256 (PR-C): the normalized loop the feeder pushes — `{version, mode,
  /// fps, frames, loopSeconds, audioEndSec, sourceSha256, normalizer, recordedAt}`
  /// (`loopProfileSchema` in core). Written once the intermediate is built and
  /// probed; null for a session that pushed the raw source (older sessions).
  loopProfile        Json?
  protocol           FeederProtocol
  /// Push coordinates: { url, streamKey } for RTMP | { host, port,
  /// passphraseCredentialId? } for SRT_CALLER. The SRT passphrase itself
  /// is NEVER stored (vault ref only, resolved at spawn). target.streamKey
  /// is connection-routing material under the SAME ledgered redaction
  /// exception as LiveChannel.streamKey: the worker must rebuild the push
  /// URL across restarts, so it stays readable in THIS column while
  /// redactSecrets keeps masking streamKey inside every persisted JSON
  /// snapshot, log line and error string.
  target             Json
  /// ffmpeg pid while PUSHING (log forensics + best-effort orphan stop);
  /// nulled on terminal states — with ONE deliberate exception: the dead-job
  /// handler (apps/worker/src/index.ts) marks the session ERROR and KEEPS the
  /// pid, because it is the operator's only pointer to a possibly-orphaned
  /// ffmpeg. That exception is what `processGoneAt` below exists to close.
  pid                Int?
  /// Host whose worker spawned `pid` (os.hostname()), written and released
  /// with it. A pid is only actionable on the host that owns it: signalling a
  /// bare number from another host kills whatever local process happens to
  /// wear it. Null on rows written before this column existed — read as "the
  /// single-worker assumption held", never as "some other host".
  ownerHost          String?
  /// Row #242 — the OWNER LEASE (audit 2026-08-29 HIGH-5). `ownerHost` says
  /// where a pid is signallable; these three say WHO is supervising the push
  /// right now, so a session survives the death of the worker that started it.
  ///
  /// `ownerId` is a worker INSTANCE id (host + pid + a per-boot nonce), not a
  /// host: two workers on one host are two owners, and a restart under the
  /// same pid is a different owner. `ownerGeneration` is the fencing token —
  /// every claim and every takeover bumps it, so a renewal, a terminal write
  /// or a log flush from a superseded owner matches ZERO rows instead of
  /// landing on the winner's row. `ownerLeaseAt` is the liveness: the owner
  /// re-stamps it on a ticker, and a lease older than the takeover window
  /// belongs to a worker that is gone.
  ///
  /// All three are NULL/0 on rows written before this column existed and on
  /// rows nobody has claimed yet (a CREATED session waiting for its start
  /// job). A NULL `ownerLeaseAt` is therefore NEVER takeable — "not claimed"
  /// and "claimed by a dead worker" are different facts, the same distinction
  /// `provisionClaimedAt` draws in `live/provision-lease.ts` (ledger #216).
  ownerId            String?
  ownerLeaseAt       DateTime?
  ownerGeneration    Int             @default(0)
  /// When `pid` was PROVEN gone: a verified kill ladder (SIGTERM → grace →
  /// SIGKILL, re-probing between rungs) or an existence probe that answered
  /// ESRCH. Audit 2026-08-29 CRITICAL-2: absence of evidence (pid = null) and
  /// evidence of absence are different facts, and DELETE needs the second —
  /// deleting an ERROR row that still carries an unreclaimed pid erases the
  /// last reference to an ffmpeg still pushing into a live ingest.
  processGoneAt      DateTime?
  /// The PUBLISHER CLAIM, a
  /// status-independent reservation of the channel's single ingest slot.
  /// `status` says what the SESSION is doing; `pid`/`processGoneAt` say what is
  /// known about the PROCESS; neither is a DB-enforced cardinality. The active
  /// partial index above covers only CREATED/DOWNLOADING/PUSHING, so a row that
  /// left the active set with its process still alive — a cross-host takeover
  /// refusal, a stop the owner's host could not verify, a dead START job — was
  /// invisible to admission while its ffmpeg kept pushing, and a second
  /// publisher could open at the same ingest until the old owner self-fenced.
  ///
  /// `publisherClaimedAt IS NOT NULL AND publisherReleasedAt IS NULL` = this row
  /// holds the channel's publisher slot. Enforced by the hand-written partial
  /// unique index `FeederSession_one_publisher_claim_per_channel` (migration
  /// SQL), so two claims on one channel cannot coexist whatever their status.
  /// A claim is taken by the owning worker BEFORE it spawns ffmpeg (an ordinary
  /// session just before the supervisor starts; a two-phase switch inside the
  /// commit CAS, after every predecessor is proven gone), and RELEASED only on
  /// positive proof that the process is gone: the owning supervisor observing
  /// its child's exit, a verified kill ladder, or ESRCH — never a terminal
  /// status, a lease expiry, or a pid-null rewrite. A staged two-phase hold
  /// (`commitAt` set, `commitRequestedAt` null) claims nothing: it cannot
  /// spawn before its commit, so several future holds coexist on one channel
  /// and serialise only at their commit. `publisherGeneration` counts claims
  /// on this row (a takeover's resumed push re-claims), so an attempt record
  /// can name which claim it served.
  publisherClaimedAt  DateTime?
  publisherReleasedAt DateTime?
  publisherGeneration Int             @default(0)
  /// Row #240 — the TWO-PHASE switch (audit 2026-08-29 HIGH-3). A switch used
  /// to enqueue a stop for the running feeder and create its replacement in
  /// the same breath; the replacement then downloaded the whole source and
  /// probed it AFTER air time (paid run #5: 29 s to PUSHING for 725 MB), and
  /// nothing waited for the old push to end — the seam was dead air or a
  /// dual push depending on queue scheduling, and no point was "the commit".
  ///
  /// `commitAt` non-null marks a session that runs in two phases. Phase A
  /// (pre-stage) downloads the sealed bytes, probes them and runs the
  /// compatibility gate, then records `readyAt` and HOLDS the spooled file
  /// without spawning. Phase B (commit) starts when `commitRequestedAt` is
  /// written — by the scheduler's commit at fireAt, or at creation for an
  /// immediate switch — and spawns only after every predecessor on the
  /// channel is proven gone (`predecessorGoneAt`); `committedAt` is the
  /// fenced write that IS the commit point, and `switchSeamMs` is the
  /// measured cost, first push minus `predecessorGoneAt`. Policy: dead air
  /// is preferred over overlap — the ingest is single-owner, so a session
  /// whose predecessor cannot be confirmed gone lands ERROR and never spawns.
  ///
  /// `readyAt` is cleared by a takeover claim: a resumed session re-stages
  /// under the new owner's generation, and the commit is fenced on the same
  /// `(ownerId, ownerGeneration)` pair as the staging — the superseded owner
  /// cannot commit a source it no longer holds.
  commitAt           DateTime?
  readyAt            DateTime?
  commitRequestedAt  DateTime?
  committedAt        DateTime?
  predecessorGoneAt  DateTime?
  switchSeamMs       Int?
  /// Append-only [{ loopIndex, wallClock, streamTimeSec }] written by the
  /// supervisor (single writer) as each -stream_loop iteration wraps —
  /// C7-style local truth: P4 VMAF live alignment depends on these.
  loopBoundaries     Json            @default("[]")
  /// Ring buffer of the last N ffmpeg-stderr/supervisor lines, scrubbed of
  /// secret literals BEFORE buffering (redaction discipline).
  logTail            Json            @default("[]")
  startedAt          DateTime?
  stoppedAt          DateTime?
  error              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  /// At most ONE active feeder session per
  /// channel whose push is UN-COORDINATED — enforced by a hand-written PARTIAL
  /// UNIQUE INDEX (`FeederSession_one_active_pusher_per_channel`) in the
  /// migration SQL, `ON (liveChannelId) WHERE status IN active AND
  /// commitAt IS NULL`. Prisma cannot express it declaratively (the #83
  /// precedent). A two-phase SWITCH row (commitAt set — row #240) is exempt: it
  /// stages behind the predecessor barrier, so it may hold a second active row
  /// for the handoff. The DB, not a check-then-act count, dedups racing creates;
  /// the loser treats P2002 as "channel already has an active feeder session".
  ///
  /// A SECOND hand-written partial unique
  /// index, `FeederSession_one_publisher_claim_per_channel`, `ON (liveChannelId)
  /// WHERE publisherClaimedAt IS NOT NULL AND publisherReleasedAt IS NULL` —
  /// at most one held publisher claim per channel, independent of `status`.
  /// The index above admits at most one uncoordinated ROW; this one admits at
  /// most one PUBLISHER, and it is the guarantee a spawn rests on.

  @@index([liveChannelId])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  /// The takeover sweep's population: non-terminal rows whose lease has gone
  /// stale. Status leads because it is the selective half — terminal rows are
  /// the overwhelming majority of this table and never take part.
  @@index([status, ownerLeaseAt])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// One durable, attempt-bound record for every feeder
/// process spawn. These identifiers deliberately are not foreign keys: the
/// operational ledger must survive deletion of a schedule, run or feeder
/// session. Rows are inserted before spawn, advanced only with facts from that
/// attempt, and never reused or deleted by feeder lifecycle code.
model FeederPushAttempt {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                  String   @id @default(uuid()) @db.Uuid
  liveScheduleId      String?  @db.Uuid
  liveChannelRunId    String?  @db.Uuid
  feederSessionId     String   @db.Uuid
  ownerGeneration     Int
  publisherGeneration Int
  attemptNo           Int
  pid                 Int?
  /// Durable pre-spawn intent. This is not provider evidence authority.
  startedAt           DateTime
  /// Captured only after runner.spawn returns with an actual process.
  processSpawnedAt    DateTime?
  /// The latest of actual process spawn, intent-clock floor and switch commit.
  /// Written atomically with pid/processSpawnedAt; null accepts no evidence.
  evidenceNotBefore   DateTime?
  endedAt             DateTime?
  exitCode            Int?
  exitSignal          String?
  /// Secret-free endpoint copied from buildFeederCommand.redactedArgv.
  sanitizedTarget     String
  /// { mode, reasons, normalise } — the A/B hook for copy vs transcode runs.
  codecDecision       Json
  sourceSha256        String?
  providerSampleAt    DateTime?
  providerStatus      String   @default("UNKNOWN")
  providerAcceptedAt  DateTime?
  createdAt           DateTime @default(now())

  @@unique([feederSessionId, ownerGeneration, attemptNo])
  @@index([liveScheduleId, startedAt])
  @@index([liveChannelRunId, startedAt])
  @@index([feederSessionId, startedAt])

  @@unique([organizationId, id])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// QC / VMAF
// ---------------------------------------------------------------------------

enum VmafMode {
  VOD
  LIVE
}

enum VmafStatus {
  PENDING
  RUNNING
  FINISHED
  ERROR
}

model VmafJob {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id             String       @id @default(uuid()) @db.Uuid
  encodingJobId  String?      @db.Uuid
  encodingJob    EncodingJob? @relation(fields: [encodingJobId], references: [id], onDelete: SetNull)
  mode           VmafMode
  /// Idempotency key for AUTOMATIC triggers (ledger #14 TOCTOU hardening):
  /// the VOD auto-trigger writes `vod-auto:<encodingJobId>` so the DB —
  /// not a check-then-act read — enforces at-most-one auto job per encoding
  /// across workers. Manual captures / future "re-run VMAF" rows stay null
  /// (Postgres unique ignores nulls), so re-runs are never blocked.
  triggerKey     String?      @unique
  /// The libvmaf model these numbers came from — ALWAYS written explicitly by
  /// both writers (the VOD auto-trigger and the live capture route), which is
  /// why this column has no default. It carried `@default("vmaf_v0.6.1")` and
  /// a doc comment naming `vmaf_phone` (never a bundled model) — a SIXTH,
  /// disagreeing spelling of "the default" that survived the move to core's
  /// DEFAULT_VMAF_MODEL because nothing takes it (review-234 (a)). A row must
  /// say which model produced its score; silently inheriting one is how a
  /// report gets compared against a different viewing condition.
  model          String
  /// Which SCORING GENERATION produced this row's numbers.
  ///
  /// 1 — before 2026-08-11. libvmaf pairs frames through ffmpeg's framesync,
  ///     i.e. by PTS, and neither input was re-timed; a mezzanine with a
  ///     non-zero first timestamp therefore had its frame N scored against the
  ///     encode's frame N±1. Measured understatement on one real encode: mean
  ///     23.08 where the corrected pipeline reports 84.21.
  /// 2 — both pads carry `setpts=N/FRAME_RATE/TB`.
  ///
  /// Persisted because generation-1 numbers are NOT comparable with
  /// generation-2 ones, and a chart that mixes them silently is worse than one
  /// that refuses to. The column defaults to 1 so every pre-existing row is
  /// labelled correctly by the migration alone; the worker writes the current
  /// generation explicitly.
  scoringVersion Int          @default(1)
  params         Json         @default("{}")
  /// QC gate verdict (ledger #86 PR2): evaluateQcGate over this run's pooled
  /// results, written atomically WITH the FINISHED status when the encoding
  /// plan carries qc.gate (null otherwise). The orchestrator continuation
  /// reads it to decide FINISHED vs QC_FAILED for BLOCK_MANIFESTS plans.
  gateVerdict    Json?
  status         VmafStatus   @default(PENDING)
  error          String?
  /// Progress + execution observability (set after the work list is built):
  /// totalUnits = targets × resolved per-title rungs; doneUnits bumped
  /// (atomic increment) after each scoring. Best-effort — a failed progress
  /// write never fails the run. totalUnits=0 ⇒ pre-migration / not-yet-set
  /// (the UI must treat it as "progress unknown").
  totalUnits     Int          @default(0)
  doneUnits      Int          @default(0)
  /// Worker CPU core count + libvmaf n_threads per run + concurrent scorings
  /// at run time (null for jobs created before this migration).
  cores          Int?
  threads        Int?
  concurrency    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  results VmafResult[]

  @@index([encodingJobId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

model VmafResult {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id           String   @id @default(uuid()) @db.Uuid
  vmafJobId    String   @db.Uuid
  vmafJob      VmafJob  @relation(fields: [vmafJobId], references: [id], onDelete: Cascade)
  /// Which rendition this result covers ({ streamId, label, bitrate, … }).
  renditionRef Json
  /// Pooled metrics: mean, harmonic mean, percentiles, 1% low.
  pooled       Json
  /// Frame-level scores; gzipped blob over ~50k frames (ARCHITECTURE §6).
  frames       Json?
  framesGzip   Bytes?
  /// The bytes this row scored.
  /// `{ reference, distorted }`, each `{ bucket, key, identity?, pinned,
  /// sha256, bytes }` — the provider's version identity read BEFORE the
  /// download and demanded DURING it (`getObject({ expect })`), plus a
  /// streaming SHA-256 of what actually arrived. A same-size overwrite between
  /// encode and scoring used to produce a plausible PASS over the wrong bytes;
  /// with this a report can say exactly which object it compared. Null on rows
  /// scored before the column existed.
  provenance   Json?
  createdAt    DateTime @default(now())

  @@index([vmafJobId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Storage object INSPECTION (P5): an ffprobe read of one object in the
/// customer's bucket, run by the worker (which owns the ffprobe binary) rather
/// than the web app. Bounded by design — the processor reads a capped HEAD and,
/// for a non-faststart MP4, a capped TAIL, never the whole object.
enum StorageInspectionStatus {
  PENDING
  RUNNING
  FINISHED
  ERROR
}

model StorageInspection {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id           String                  @id @default(uuid()) @db.Uuid
  credentialId String                  @db.Uuid
  /// Cascade, matching StorageLocationPreset (the only other Credential
  /// dependent): an inspection row is DERIVED from this credential's
  /// authorization to read that bucket, and it holds customer data — bucket
  /// name, object key, media metadata. Deleting the credential revokes the
  /// authorization, so the records it produced must not outlive it. SetNull is
  /// not an option either way: `credentialId` is non-null and the GET filters
  /// on it, so a nulled row would be unreachable garbage.
  credential   Credential              @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  bucket       String
  objectKey    String
  status       StorageInspectionStatus @default(PENDING)
  /// Raw ffprobe JSON (-show_format -show_streams). Media metadata only — no
  /// credential material — but still written through redactSecrets.
  probe        Json?
  /// How many bytes the probe actually read (head + optional tail).
  bytesRead    Int?
  /// The object's size from the LISTING that offered Inspect (ledger #26).
  /// Optional: entry points that don't know it (job-detail input cards) omit
  /// it and the probe falls back to the next-slice retry. BigInt — mezzanines
  /// exceed Int32. Advisory only: the worker still bounds on arrival and
  /// requires Content-Range, so a stale/wrong size cannot unbound the read.
  objectSize   BigInt?
  error        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  /// Serves the ONLY query this table has: the latest inspection of one
  /// object — findFirst on (credentialId, bucket, objectKey) ordered by
  /// createdAt desc. The trailing sorted column makes it a covering lookup
  /// instead of a filter-then-sort.
  @@index([credentialId, bucket, objectKey, createdAt(sort: Desc)])
  /// Kept for the retention prune (ledger #27), which scans by age alone.
  @@index([createdAt(sort: Desc)])

  @@unique([organizationId, id])
  @@index([organizationId])
}

