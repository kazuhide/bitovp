			"presetConfiguration": "VOD_STANDARD"
		},
		"refs": {}
	},
	{
		"step": "stream:v360",
		"kind": "CREATE_STREAM",
		"payload": {
			"name": "Stream AV1 360p",
			"mode": "STANDARD"
		},
		"refs": {
			"encodingId": "encoding",
			"codecConfigId": "codec:v360",
			"inputStreamId": "ingest:video"
		}
	},
	{
		"step": "muxing:v360",
		"kind": "CREATE_MUXING_FMP4",
		"payload": {
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
