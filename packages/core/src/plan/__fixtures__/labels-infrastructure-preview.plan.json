			"position": 0
		},
		{
			"key": "audio",
			"inputKey": "main",
			"inputPath": "sintel/Sintel.2010.1080p.mkv",
			"selectionMode": "AUDIO_RELATIVE",
			"position": 0
		}
	],
	"renditions": [
		{
			"key": "v540",
			"codec": "H264",
			"ingestKey": "video",
			"height": 540,
			"bitrate": 600000,
			"level": null,
