{
	"planVersion": 1,
	"name": "HLS MPEG-TS with audio muxed into each variant (hls-ts-muxed-av)",
	"bitmovin": {
		"cloudRegion": "AWS_AP_NORTHEAST_1",
		"encoderVersion": "STABLE"
	},
	"inputs": [
		{
			"key": "main",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000001",
			"bucket": "sample-input-bucket",
			"name": "Test S3 Input"
		}
	],
	"outputs": [
		{
			"key": "origin",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucket": "sample-output-bucket",
			"name": "Test S3 Output"
		}
	],
	"ingest": [
		{
			"key": "video",
			"inputKey": "main",
			"inputPath": "/path/to/your/input/file.mp4",
			"selectionMode": "VIDEO_RELATIVE",
			"position": 0
		},
		{
			"key": "audio",
			"inputKey": "main",
			"inputPath": "/path/to/your/input/file.mp4",
			"selectionMode": "AUDIO_RELATIVE",
			"position": 0
		}
	],
	"renditions": [
		{
			"key": "v360",
			"codec": "H264",
			"name": "H264 360p",
			"ingestKey": "video",
			"height": 360,
			"bitrate": 800000,
			"profile": "MAIN"
		},
		{
			"key": "v720",
			"codec": "H264",
			"name": "H264 720p",
			"ingestKey": "video",
			"height": 720,
			"bitrate": 2400000,
			"profile": "MAIN"
		},
		{
			"key": "a128",
			"codec": "AAC",
			"name": "AAC 128kbps",
			"ingestKey": "audio",
			"bitrate": 128000,
			"rate": 48000
		}
	],
	"muxings": [
		{
			"key": "v360-ts",
			"kind": "TS",
			"streamKey": "v360",
			"additionalStreamKeys": ["a128"],
			"segmentLength": 6,
			"segmentNaming": "seg_%number%.ts",
			"destination": {
				"outputKey": "origin",
				"path": "output/hls-ts-muxed-av/video/360p",
				"acl": "PUBLIC_READ"
			}
		},
		{
			"key": "v720-ts",
			"kind": "TS",
			"streamKey": "v720",
			"additionalStreamKeys": ["a128"],
			"segmentLength": 6,
			"segmentNaming": "seg_%number%.ts",
			"destination": {
				"outputKey": "origin",
				"path": "output/hls-ts-muxed-av/video/720p",
				"acl": "PUBLIC_READ"
			}
		}
	],
	"manifests": [
		{
			"key": "hls",
			"kind": "HLS",
			"manifestName": "stream.m3u8",
			"name": "HLS Manifest",
			"destination": {
				"outputKey": "origin",
				"path": "output/hls-ts-muxed-av/",
				"acl": "PUBLIC_READ"
			},
			"masterVersion": "HLS_V6",
			"mediaVersion": "HLS_V6",
			"audioGroupId": "audio",
			"audioLanguage": "en",
			"closedCaptions": "NONE"
		}
	],
	"generation": {
		"timing": "POST_ENCODING"
	}
}
