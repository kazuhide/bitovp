[
	{
		"step": "input:main",
		"kind": "CREATE_INPUT_S3",
		"payload": {
			"name": "Test S3 Input",
			"credentialId": "00000000-0000-4000-8000-000000000001",
			"bucketName": "sample-input-bucket"
		},
		"refs": {}
	},
	{
		"step": "output:origin",
		"kind": "CREATE_OUTPUT_S3",
		"payload": {
			"name": "Test S3 Output",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucketName": "sample-output-bucket"
		},
		"refs": {}
	},
	{
		"step": "encoding",
		"kind": "CREATE_ENCODING",
		"payload": {
			"name": "Sample Audio-Only AAC Encoding (audio-only-aac-fmp4-hls-dash)",
			"cloudRegion": "AWS_AP_NORTHEAST_1",
			"encoderVersion": "STABLE"
		},
		"refs": {}
	},
	{
		"step": "ingest:audio",
		"kind": "CREATE_INGEST_INPUT_STREAM",
		"payload": {
			"inputPath": "/path/to/your/input/audio.mp3",
			"selectionMode": "AUDIO_RELATIVE",
			"position": 0
		},
		"refs": {
			"encodingId": "encoding",
			"inputId": "input:main"
		}
	},
	{
		"step": "codec:a128",
		"kind": "CREATE_CODEC_AAC",
		"payload": {
			"name": "AAC 128kbps",
			"bitrate": 128000,
			"rate": 48000,
			"channelLayout": "CL_STEREO"
		},
		"refs": {}
	},
	{
		"step": "stream:a128",
		"kind": "CREATE_STREAM",
		"payload": {
			"name": "Stream AAC 128kbps",
			"mode": "STANDARD"
		},
		"refs": {
			"encodingId": "encoding",
			"codecConfigId": "codec:a128",
			"inputStreamId": "ingest:audio"
		}
	},
	{
		"step": "muxing:a128",
		"kind": "CREATE_MUXING_FMP4",
		"payload": {
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"outputPath": "output/audio-only-aac-fmp4-hls-dash/audio/128000",
			"acl": "PUBLIC_READ",
			"name": "Audio FMP4 Muxing 128kbps"
		},
		"refs": {
			"encodingId": "encoding",
			"streamId": "stream:a128",
			"outputId": "output:origin"
		}
	},
	{
		"step": "start",
		"kind": "START_ENCODING",
		"payload": {},
		"refs": {
			"encodingId": "encoding"
		}
	},
	{
		"step": "await:encoding",
		"kind": "AWAIT_ENCODING",
		"payload": {},
		"refs": {
			"encodingId": "encoding"
		}
	},
	{
		"step": "manifest:dash",
		"kind": "CREATE_MANIFEST_DASH",
		"payload": {
			"manifestName": "stream.mpd",
			"name": "DASH Manifest",
			"outputPath": "output/audio-only-aac-fmp4-hls-dash/",
			"acl": "PUBLIC_READ"
		},
		"refs": {
			"outputId": "output:origin"
		}
	},
	{
		"step": "manifest:dash:period",
		"kind": "CREATE_DASH_PERIOD",
		"payload": {},
		"refs": {
			"manifestId": "manifest:dash"
		}
	},
	{
		"step": "manifest:dash:aset-audio",
		"kind": "CREATE_DASH_ADAPTATION_SET_AUDIO",
		"payload": {
			"lang": "en"
		},
		"refs": {
			"manifestId": "manifest:dash",
			"periodId": "manifest:dash:period"
		}
	},
	{
		"step": "manifest:dash:rep:a128",
		"kind": "CREATE_DASH_REPRESENTATION_FMP4",
		"payload": {
			"type": "TEMPLATE",
			"mode": "TEMPLATE_REPRESENTATION",
			"segmentPath": "audio/128000"
		},
		"refs": {
			"manifestId": "manifest:dash",
			"periodId": "manifest:dash:period",
			"adaptationSetId": "manifest:dash:aset-audio",
			"encodingId": "encoding",
			"muxingId": "muxing:a128"
		}
	},
	{
		"step": "manifest:hls",
		"kind": "CREATE_MANIFEST_HLS",
		"payload": {
			"manifestName": "stream.m3u8",
			"name": "HLS Manifest",
			"hlsMasterPlaylistVersion": "HLS_V6",
			"hlsMediaPlaylistVersion": "HLS_V6",
			"outputPath": "output/audio-only-aac-fmp4-hls-dash/",
			"acl": "PUBLIC_READ"
		},
		"refs": {
			"outputId": "output:origin"
		}
	},
	{
		"step": "hls-media:hls:a128",
		"kind": "CREATE_HLS_AUDIO_MEDIA",
		"payload": {
			"name": "HLS Audio Media",
			"groupId": "audio",
			"language": "en",
			"segmentPath": "audio/128000",
			"uri": "audio_128000.m3u8"
		},
		"refs": {
			"manifestId": "manifest:hls",
			"encodingId": "encoding",
			"streamId": "stream:a128",
			"muxingId": "muxing:a128"
		}
	},
	{
		"step": "manifest-start:dash",
		"kind": "START_MANIFEST_DASH",
		"payload": {
			"manifestGenerator": "V2"
		},
		"refs": {
			"manifestId": "manifest:dash"
		}
	},
	{
		"step": "manifest-await:dash",
		"kind": "AWAIT_MANIFEST_DASH",
		"payload": {},
		"refs": {
			"manifestId": "manifest:dash"
		}
	},
	{
		"step": "manifest-start:hls",
		"kind": "START_MANIFEST_HLS",
		"payload": {
			"manifestGenerator": "V2"
		},
		"refs": {
			"manifestId": "manifest:hls"
		}
	},
	{
		"step": "manifest-await:hls",
		"kind": "AWAIT_MANIFEST_HLS",
		"payload": {},
		"refs": {
			"manifestId": "manifest:hls"
		}
	}
]
