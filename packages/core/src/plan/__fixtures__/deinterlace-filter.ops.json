[
	{
		"step": "input:main",
		"kind": "CREATE_INPUT_S3",
		"payload": {
			"name": "Test S3 Input",
			"credentialId": "00000000-0000-4000-8000-000000000001",
			"bucketName": "sample-input-bucket"
		},
		"refs": {}
	},
	{
		"step": "output:origin",
		"kind": "CREATE_OUTPUT_S3",
		"payload": {
			"name": "Test S3 Output",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucketName": "sample-output-bucket"
		},
		"refs": {}
	},
	{
		"step": "encoding",
		"kind": "CREATE_ENCODING",
		"payload": {
			"name": "deinterlace-sample",
			"cloudRegion": "AUTO",
			"encoderVersion": "STABLE"
		},
		"refs": {}
	},
	{
		"step": "ingest:video",
		"kind": "CREATE_INGEST_INPUT_STREAM",
		"payload": {
			"inputPath": "<INSERT YOUR INPUT PATH>",
			"selectionMode": "VIDEO_RELATIVE",
			"position": 0
		},
		"refs": {
			"encodingId": "encoding",
			"inputId": "input:main"
		}
	},
	{
		"step": "ingest:audio",
		"kind": "CREATE_INGEST_INPUT_STREAM",
		"payload": {
			"inputPath": "<INSERT YOUR INPUT PATH>",
			"selectionMode": "AUDIO_RELATIVE",
			"position": 0
		},
		"refs": {
			"encodingId": "encoding",
			"inputId": "input:main"
		}
	},
	{
		"step": "codec:v1080",
		"kind": "CREATE_CODEC_H264",
		"payload": {
			"name": "Sample video codec configuration",
			"height": 1080,
			"bitrate": 2000000,
			"level": null,
			"presetConfiguration": "VOD_STANDARD"
		},
		"refs": {}
	},
	{
		"step": "stream:v1080",
		"kind": "CREATE_STREAM",
		"payload": {
			"name": "Stream H264 1080p",
			"mode": "STANDARD"
		},
		"refs": {
			"encodingId": "encoding",
			"codecConfigId": "codec:v1080",
			"inputStreamId": "ingest:video"
		}
	},
	{
		"step": "filter:v1080:deint",
		"kind": "CREATE_FILTER_DEINTERLACE",
		"payload": {
			"parity": "AUTO",
			"mode": "FRAME",
			"frameSelectionMode": "ALL",
			"autoEnable": "META_DATA_AND_CONTENT_BASED"
		},
		"refs": {}
	},
	{
		"step": "stream-filters:v1080",
		"kind": "CREATE_STREAM_FILTERS",
		"payload": {
			"positions": [
				0
			]
		},
		"refs": {
			"encodingId": "encoding",
			"streamId": "stream:v1080",
			"filterIds": [
				"filter:v1080:deint"
			]
		}
	},
	{
		"step": "muxing:v1080",
		"kind": "CREATE_MUXING_FMP4",
		"payload": {
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"outputPath": "output/deinterlace-sample/video/1080p",
			"acl": "PUBLIC_READ",
			"name": "Video FMP4 Muxing 1080p"
		},
		"refs": {
			"encodingId": "encoding",
			"streamId": "stream:v1080",
			"outputId": "output:origin"
		}
	},
	{
		"step": "codec:a128",
		"kind": "CREATE_CODEC_AAC",
		"payload": {
			"bitrate": 128000,
			"rate": 48000,
			"channelLayout": "CL_STEREO"
		},
		"refs": {}
	},
	{
		"step": "stream:a128",
		"kind": "CREATE_STREAM",
		"payload": {
			"name": "Stream AAC 128kbps",
			"mode": "STANDARD"
		},
		"refs": {
			"encodingId": "encoding",
			"codecConfigId": "codec:a128",
			"inputStreamId": "ingest:audio"
		}
	},
	{
		"step": "muxing:a128",
		"kind": "CREATE_MUXING_FMP4",
		"payload": {
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"outputPath": "output/deinterlace-sample/audio/128000",
			"acl": "PUBLIC_READ",
			"name": "Audio FMP4 Muxing 128kbps"
		},
		"refs": {
			"encodingId": "encoding",
			"streamId": "stream:a128",
			"outputId": "output:origin"
		}
	},
	{
		"step": "manifest:dash",
		"kind": "CREATE_MANIFEST_DASH",
		"payload": {
			"manifestName": "stream.mpd",
			"name": "DASH Manifest",
			"outputPath": "output/deinterlace-sample/",
			"acl": "PUBLIC_READ"
		},
		"refs": {
			"outputId": "output:origin"
		}
	},
	{
		"step": "manifest:dash:period",
		"kind": "CREATE_DASH_PERIOD",
		"payload": {},
		"refs": {
			"manifestId": "manifest:dash"
		}
	},
	{
		"step": "manifest:dash:aset-video",
		"kind": "CREATE_DASH_ADAPTATION_SET_VIDEO",
		"payload": {},
		"refs": {
			"manifestId": "manifest:dash",
			"periodId": "manifest:dash:period"
		}
	},
	{
		"step": "manifest:dash:aset-audio",
		"kind": "CREATE_DASH_ADAPTATION_SET_AUDIO",
		"payload": {
			"lang": "en"
		},
		"refs": {
			"manifestId": "manifest:dash",
			"periodId": "manifest:dash:period"
		}
	},
	{
		"step": "manifest:dash:rep:v1080",
		"kind": "CREATE_DASH_REPRESENTATION_FMP4",
		"payload": {
			"type": "TEMPLATE",
			"mode": "TEMPLATE_REPRESENTATION",
			"segmentPath": "video/1080p"
		},
		"refs": {
			"manifestId": "manifest:dash",
			"periodId": "manifest:dash:period",
			"adaptationSetId": "manifest:dash:aset-video",
			"encodingId": "encoding",
			"muxingId": "muxing:v1080"
		}
	},
	{
		"step": "manifest:dash:rep:a128",
		"kind": "CREATE_DASH_REPRESENTATION_FMP4",
		"payload": {
			"type": "TEMPLATE",
			"mode": "TEMPLATE_REPRESENTATION",
			"segmentPath": "audio/128000"
		},
		"refs": {
			"manifestId": "manifest:dash",
			"periodId": "manifest:dash:period",
			"adaptationSetId": "manifest:dash:aset-audio",
			"encodingId": "encoding",
			"muxingId": "muxing:a128"
		}
	},
	{
		"step": "manifest:hls",
		"kind": "CREATE_MANIFEST_HLS",
		"payload": {
			"manifestName": "stream.m3u8",
			"name": "HLS Manifest",
			"hlsMasterPlaylistVersion": "HLS_V6",
			"hlsMediaPlaylistVersion": "HLS_V6",
			"outputPath": "output/deinterlace-sample/",
			"acl": "PUBLIC_READ"
		},
		"refs": {
			"outputId": "output:origin"
		}
	},
	{
		"step": "hls-variant:hls:v1080",
		"kind": "CREATE_HLS_STREAM_INFO",
		"payload": {
			"audio": "audio",
			"closedCaptions": "NONE",
			"segmentPath": "video/1080p",
			"uri": "video_2000000.m3u8"
		},
		"refs": {
			"manifestId": "manifest:hls",
			"encodingId": "encoding",
			"streamId": "stream:v1080",
			"muxingId": "muxing:v1080"
		}
	},
	{
		"step": "hls-media:hls:a128",
		"kind": "CREATE_HLS_AUDIO_MEDIA",
		"payload": {
			"name": "HLS Audio Media",
			"groupId": "audio",
			"language": "en",
			"segmentPath": "audio/128000",
			"uri": "audio_128000.m3u8"
		},
		"refs": {
			"manifestId": "manifest:hls",
			"encodingId": "encoding",
			"streamId": "stream:a128",
			"muxingId": "muxing:a128"
		}
	},
	{
		"step": "start",
		"kind": "START_ENCODING",
		"payload": {
			"manifestGenerator": "V2"
		},
		"refs": {
			"encodingId": "encoding",
			"vodHlsManifestIds": [
				"manifest:hls"
			],
			"vodDashManifestIds": [
				"manifest:dash"
			]
		}
	},
	{
		"step": "await:encoding",
		"kind": "AWAIT_ENCODING",
		"payload": {},
		"refs": {
			"encodingId": "encoding"
		}
	}
]
