{
	"planVersion": 1,
	"name": "av1-aac-fmp4-dash-hls-aws",
	"bitmovin": {
		"cloudRegion": "AWS_AP_NORTHEAST_1",
		"encoderVersion": "STABLE"
	},
	"inputs": [
		{
			"key": "main",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000001",
			"bucket": "sample-input-bucket",
			"name": "Test S3 Input"
		}
	],
	"outputs": [
		{
			"key": "origin",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucket": "sample-output-bucket",
			"name": "Test S3 Output"
		}
	],
	"ingest": [
		{
			"key": "video",
			"inputKey": "main",
			"inputPath": "sintel/Sintel.2010.1080p.mkv",
			"selectionMode": "VIDEO_RELATIVE",
			"position": 0
		},
		{
			"key": "audio",
			"inputKey": "main",
			"inputPath": "sintel/Sintel.2010.1080p.mkv",
			"selectionMode": "AUDIO_RELATIVE",
			"position": 0
		}
	],
	"renditions": [
		{
			"key": "v360",
			"codec": "AV1",
			"ingestKey": "video",
			"height": 360,
			"bitrate": 600000,
			"mode": "STANDARD",
			"presetConfiguration": "VOD_STANDARD"
		},
		{
			"key": "v720",
			"codec": "AV1",
			"ingestKey": "video",
			"height": 720,
			"bitrate": 1500000,
			"mode": "STANDARD",
			"presetConfiguration": "VOD_QUALITY",
			"autoLevelSetup": "ENABLED",
			"colorConfig": {
				"copyColorPrimariesFlag": true,
				"copyColorTransferFlag": true,
				"copyColorSpaceFlag": true
			}
		},
		{
			"key": "a128",
			"codec": "AAC",
			"ingestKey": "audio",
			"bitrate": 128000,
			"rate": 48000,
			"channelLayout": "CL_STEREO",
			"conditions": {
				"attribute": "AUDIOSTREAMCOUNT",
				"operator": "GREATER_THAN",
				"value": "0"
			}
		}
	],
	"muxings": [
		{
			"key": "v360",
			"kind": "FMP4",
			"streamKey": "v360",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/av1-aac-fmp4-dash-hls-aws/video/360p",
				"acl": "PUBLIC_READ"
			}
		},
		{
			"key": "v720",
			"kind": "FMP4",
			"streamKey": "v720",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/av1-aac-fmp4-dash-hls-aws/video/720p",
				"acl": "PUBLIC_READ"
			}
		},
		{
			"key": "a128",
			"kind": "FMP4",
			"streamKey": "a128",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/av1-aac-fmp4-dash-hls-aws/audio/128000",
				"acl": "PUBLIC_READ"
			}
		}
	],
	"manifests": [
		{
			"key": "hls",
			"kind": "HLS",
			"manifestName": "stream.m3u8",
			"name": "HLS Manifest",
			"destination": {
				"outputKey": "origin",
				"path": "output/av1-aac-fmp4-dash-hls-aws/",
				"acl": "PUBLIC_READ"
			},
			"masterVersion": "HLS_V4",
			"mediaVersion": "HLS_V4",
			"audioGroupId": "audio",
			"audioLanguage": "en",
			"closedCaptions": "NONE"
		},
		{
			"key": "dash",
			"kind": "DASH",
			"manifestName": "stream.mpd",
			"name": "DASH Manifest",
			"destination": {
				"outputKey": "origin",
				"path": "output/av1-aac-fmp4-dash-hls-aws/",
				"acl": "PUBLIC_READ"
			},
			"audioLanguage": "ja",
			"representationType": "TEMPLATE"
		}
	],
	"generation": {
		"timing": "JUST_IN_TIME"
	}
}
