{
	"planVersion": 1,
	"name": "gcs-service-account-io",
	"bitmovin": {
		"cloudRegion": "GOOGLE_EUROPE_WEST_1",
		"encoderVersion": "STABLE"
	},
	"inputs": [
		{
			"key": "main",
			"kind": "GCS_SERVICE_ACCOUNT",
			"credentialId": "00000000-0000-4000-8000-000000000001",
			"bucket": "gcs-input-bucket",
			"region": "EUROPE_WEST_1",
			"name": "GCS Service Account Input"
		}
	],
	"outputs": [
		{
			"key": "origin",
			"kind": "GCS_SERVICE_ACCOUNT",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucket": "gcs-output-bucket",
			"region": "EUROPE_WEST_1",
			"name": "GCS Service Account Output"
		}
	],
	"ingest": [
		{
			"key": "video",
			"inputKey": "main",
			"inputPath": "sintel/Sintel.2010.1080p.mkv",
			"selectionMode": "VIDEO_RELATIVE",
			"position": 0
		},
		{
			"key": "audio",
			"inputKey": "main",
			"inputPath": "sintel/Sintel.2010.1080p.mkv",
			"selectionMode": "AUDIO_RELATIVE",
			"position": 0
		}
	],
	"renditions": [
		{
			"key": "v360",
			"codec": "H264",
			"ingestKey": "video",
			"height": 360,
			"bitrate": 300000,
			"level": null,
			"presetConfiguration": "VOD_HIGH_QUALITY",
			"mode": "STANDARD"
		},
		{
			"key": "a128",
			"codec": "AAC",
			"ingestKey": "audio",
			"bitrate": 128000,
			"rate": 48000,
			"channelLayout": "CL_STEREO"
		}
	],
	"muxings": [
		{
			"key": "v360",
			"kind": "FMP4",
			"streamKey": "v360",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/gcs-service-account-io/video/360p"
			}
		},
		{
			"key": "a128",
			"kind": "FMP4",
			"streamKey": "a128",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/gcs-service-account-io/audio/128000"
			}
		}
	],
	"manifests": [
		{
			"key": "dash",
			"kind": "DASH",
			"manifestName": "stream.mpd",
			"name": "DASH Manifest",
			"destination": {
				"outputKey": "origin",
				"path": "output/gcs-service-account-io/"
			},
			"audioLanguage": "en"
		}
	],
	"generation": {
		"timing": "POST_ENCODING"
	}
}
