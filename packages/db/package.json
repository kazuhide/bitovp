{
	"name": "@bitovp/db",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "prisma generate",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"db:migrate": "tsx scripts/migrate.ts dev",
		"db:migrate:deploy": "tsx scripts/migrate.ts deploy",
		"db:runtime:init": "tsx scripts/prepare-runtime-role.ts --init-admin-env",
		"db:runtime:import-admin": "tsx scripts/prepare-runtime-role.ts --import-existing-admin",
		"db:runtime:prepare": "tsx scripts/prepare-runtime-role.ts",
		"db:studio": "prisma studio"
	},
	"dependencies": {
		"@bitovp/core": "workspace:*",
		"@prisma/client": "^6.0.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"prisma": "^6.0.0",
		"tsx": "4.22.5",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
