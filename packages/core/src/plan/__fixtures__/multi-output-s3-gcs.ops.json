[
	{
		"step": "input:main",
		"kind": "CREATE_INPUT_S3",
		"payload": {
			"name": "Test S3 Input",
			"credentialId": "00000000-0000-4000-8000-000000000001",
			"bucketName": "sample-input-bucket"
		},
		"refs": {}
	},
	{
		"step": "output:origin",
		"kind": "CREATE_OUTPUT_S3",
		"payload": {
			"name": "Test S3 Output",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucketName": "sample-output-bucket"
		},
		"refs": {}
	},
	{
		"step": "output:mirror-1",
		"kind": "CREATE_OUTPUT_GCS",
		"payload": {
			"name": "Test GCS Mirror Output",
			"credentialId": "00000000-0000-4000-8000-000000000003",
			"bucketName": "sample-mirror-bucket"
		},
		"refs": {}
	},
	{
		"step": "encoding",
		"kind": "CREATE_ENCODING",
		"payload": {
			"name": "Synthetic Multi-Output S3+GCS (multi-output-s3-gcs)",
			"cloudRegion": "AWS_AP_NORTHEAST_1",
			"encoderVersion": "STABLE"
		},
		"refs": {}
	},
	{
		"step": "ingest:video",
		"kind": "CREATE_INGEST_INPUT_STREAM",
		"payload": {
			"inputPath": "/path/to/your/input/video.mp4",
			"selectionMode": "VIDEO_RELATIVE",
			"position": 0
		},
		"refs": {
			"encodingId": "encoding",
			"inputId": "input:main"
		}
	},
	{
		"step": "ingest:audio",
		"kind": "CREATE_INGEST_INPUT_STREAM",
		"payload": {
			"inputPath": "/path/to/your/input/video.mp4",
			"selectionMode": "AUDIO_RELATIVE",
			"position": 0
		},
		"refs": {
			"encodingId": "encoding",
			"inputId": "input:main"
		}
	},
	{
		"step": "codec:v720",
		"kind": "CREATE_CODEC_H264",
		"payload": {
			"name": "Sample video codec configuration",
			"height": 720,
			"bitrate": 3000000,
			"level": null,
			"presetConfiguration": "VOD_HIGH_QUALITY"
		},
		"refs": {}
	},
	{
		"step": "stream:v720",
		"kind": "CREATE_STREAM",
		"payload": {
			"name": "Stream H264 720p",
			"mode": "STANDARD"
		},
		"refs": {
			"encodingId": "encoding",
			"codecConfigId": "codec:v720",
			"inputStreamId": "ingest:video"
		}
	},
	{
		"step": "muxing:v720",
		"kind": "CREATE_MUXING_FMP4",
		"payload": {
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"outputPath": "output/multi-output-s3-gcs/video/720p",
			"acl": "PUBLIC_READ",
			"name": "Video FMP4 Muxing 720p"
		},
		"refs": {
			"encodingId": "encoding",
			"streamId": "stream:v720",
			"outputId": "output:origin",
			"mirrorOutputIds": [
				"output:mirror-1"
			]
		}
	},
	{
		"step": "codec:a128",
		"kind": "CREATE_CODEC_AAC",
		"payload": {
			"bitrate": 128000,
			"rate": 48000,
			"channelLayout": "CL_STEREO"
		},
		"refs": {}
	},
	{
		"step": "stream:a128",
		"kind": "CREATE_STREAM",
		"payload": {
			"name": "Stream AAC 128kbps",
			"mode": "STANDARD"
		},
		"refs": {
			"encodingId": "encoding",
			"codecConfigId": "codec:a128",
			"inputStreamId": "ingest:audio"
		}
	},
	{
		"step": "muxing:a128",
		"kind": "CREATE_MUXING_FMP4",
		"payload": {
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"outputPath": "output/multi-output-s3-gcs/audio/128000",
			"acl": "PUBLIC_READ",
			"name": "Audio FMP4 Muxing 128kbps"
		},
		"refs": {
			"encodingId": "encoding",
			"streamId": "stream:a128",
			"outputId": "output:origin",
			"mirrorOutputIds": [
				"output:mirror-1"
			]
		}
	},
	{
		"step": "manifest:hls",
		"kind": "CREATE_MANIFEST_HLS",
		"payload": {
			"manifestName": "stream.m3u8",
			"name": "HLS Manifest",
			"hlsMasterPlaylistVersion": "HLS_V6",
			"hlsMediaPlaylistVersion": "HLS_V6",
			"outputPath": "output/multi-output-s3-gcs/",
			"acl": "PUBLIC_READ"
		},
		"refs": {
			"outputId": "output:origin",
			"mirrorOutputIds": [
				"output:mirror-1"
			]
		}
	},
	{
		"step": "hls-variant:hls:v720",
		"kind": "CREATE_HLS_STREAM_INFO",
		"payload": {
			"audio": "audio",
			"closedCaptions": "NONE",
			"segmentPath": "video/720p",
			"uri": "video_3000000.m3u8"
		},
		"refs": {
			"manifestId": "manifest:hls",
			"encodingId": "encoding",
			"streamId": "stream:v720",
			"muxingId": "muxing:v720"
		}
	},
	{
		"step": "hls-media:hls:a128",
		"kind": "CREATE_HLS_AUDIO_MEDIA",
		"payload": {
			"name": "HLS Audio Media",
			"groupId": "audio",
			"language": "en",
			"segmentPath": "audio/128000",
			"uri": "audio_128000.m3u8"
		},
		"refs": {
			"manifestId": "manifest:hls",
			"encodingId": "encoding",
			"streamId": "stream:a128",
			"muxingId": "muxing:a128"
		}
	},
	{
		"step": "start",
		"kind": "START_ENCODING",
		"payload": {
			"manifestGenerator": "V2"
		},
		"refs": {
			"encodingId": "encoding",
			"vodHlsManifestIds": [
				"manifest:hls"
			]
		}
	},
	{
		"step": "await:encoding",
		"kind": "AWAIT_ENCODING",
		"payload": {},
		"refs": {
			"encodingId": "encoding"
		}
	}
]
