{
	"planVersion": 1,
	"name": "Live Redundant RTMP Channel (live-redundant-rtmp)",
	"bitmovin": {
		"cloudRegion": "AWS_AP_NORTHEAST_1",
		"encoderVersion": "STABLE"
	},
	"liveInput": {
		"key": "main",
		"kind": "REDUNDANT_RTMP",
		"name": "Redundant RTMP Input",
		"delayThreshold": 12,
		"ingestPoints": [
			{
				"applicationName": "liveA",
				"streamKey": "primaryFeed"
			},
			{
				"applicationName": "liveB",
				"streamKey": "backupFeed"
			}
		]
	},
	"outputs": [
		{
			"key": "origin",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucket": "sample-output-bucket",
			"name": "Test S3 Output"
		}
	],
	"ingest": [
		{
			"key": "video",
			"inputPath": "/",
			"position": 0
		},
		{
			"key": "audio",
			"inputPath": "/",
			"position": 1
		}
	],
	"renditions": [
		{
			"key": "v1080",
			"codec": "H264",
			"name": "Live H264 1080p",
			"ingestKey": "video",
			"height": 1080,
			"bitrate": 4500000,
			"level": null,
			"presetConfiguration": "LIVE_STANDARD",
			"mode": "STANDARD"
		},
		{
			"key": "v720",
			"codec": "H264",
			"name": "Live H264 720p",
			"ingestKey": "video",
			"height": 720,
			"bitrate": 3000000,
			"level": null,
			"presetConfiguration": "LIVE_STANDARD",
			"mode": "STANDARD"
		},
		{
			"key": "a128",
			"codec": "AAC",
			"ingestKey": "audio",
			"bitrate": 128000,
			"rate": 48000,
			"channelLayout": "CL_STEREO"
		}
	],
	"muxings": [
		{
			"key": "v1080",
			"kind": "FMP4",
			"streamKey": "v1080",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-redundant-rtmp/video/1080p"
			}
		},
		{
			"key": "v720",
			"kind": "FMP4",
			"streamKey": "v720",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-redundant-rtmp/video/720p"
			}
		},
		{
			"key": "a128",
			"kind": "FMP4",
			"streamKey": "a128",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-redundant-rtmp/audio/128000"
			}
		}
	],
	"liveManifests": [
		{
			"key": "hls",
			"kind": "HLS",
			"manifestName": "stream.m3u8",
			"name": "Live HLS Manifest",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-redundant-rtmp"
			},
			"audioGroupId": "audio",
			"audioLanguage": "en",
			"closedCaptions": "NONE",
			"timeshift": 3600
		},
		{
			"key": "dash",
			"kind": "DASH",
			"manifestName": "stream.mpd",
			"name": "Live DASH Manifest",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-redundant-rtmp"
			},
			"audioLanguage": "en",
			"representationType": "TEMPLATE",
			"timeshift": 3600
		}
	],
	"start": {
		"streamKey": "redundantKey"
	}
}
