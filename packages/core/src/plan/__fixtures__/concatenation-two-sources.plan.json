{
	"planVersion": 1,
	"name": "Synthetic Two-Source Concatenation (concatenation-two-sources)",
	"bitmovin": {
		"cloudRegion": "AWS_AP_NORTHEAST_1",
		"encoderVersion": "STABLE"
	},
	"inputs": [
		{
			"key": "main",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000001",
			"bucket": "sample-input-bucket",
			"name": "Test S3 Input"
		}
	],
	"outputs": [
		{
			"key": "origin",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucket": "sample-output-bucket",
			"name": "Test S3 Output"
		}
	],
	"ingest": [
		{
			"key": "partA",
			"inputKey": "main",
			"inputPath": "/path/to/your/input/part-a.mp4",
			"selectionMode": "VIDEO_RELATIVE",
			"position": 0
		},
		{
			"key": "partB",
			"inputKey": "main",
			"inputPath": "/path/to/your/input/part-b.mp4",
			"selectionMode": "VIDEO_RELATIVE",
			"position": 0
		}
	],
	"concatenationStreams": [
		{
			"key": "joined",
			"sources": [
				{
					"sourceKey": "partA",
					"isMain": true,
					"position": 0
				},
				{
					"sourceKey": "partB",
					"position": 1
				}
			]
		}
	],
	"renditions": [
		{
			"key": "v720",
			"codec": "H264",
			"name": "H264 720p",
			"ingestKey": "joined",
			"height": 720,
			"bitrate": 3000000
		}
	],
	"muxings": [
		{
			"key": "v720",
			"kind": "FMP4",
			"streamKey": "v720",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/concatenation-two-sources/video/720p",
				"acl": "PUBLIC_READ"
			}
		}
	],
	"manifests": [
		{
			"key": "hls",
			"kind": "HLS",
			"manifestName": "stream.m3u8",
			"name": "HLS Manifest",
			"destination": {
				"outputKey": "origin",
				"path": "output/concatenation-two-sources/",
				"acl": "PUBLIC_READ"
			},
			"masterVersion": "HLS_V6",
			"mediaVersion": "HLS_V6",
			"audioGroupId": "audio",
			"audioLanguage": "en",
			"closedCaptions": "NONE"
		}
	],
	"generation": {
		"timing": "JUST_IN_TIME"
	}
}
