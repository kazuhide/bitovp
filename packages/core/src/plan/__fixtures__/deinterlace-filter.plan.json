{
	"planVersion": 1,
	"name": "deinterlace-sample",
	"bitmovin": {
		"cloudRegion": "AUTO",
		"encoderVersion": "STABLE"
	},
	"inputs": [
		{
			"key": "main",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000001",
			"bucket": "sample-input-bucket",
			"name": "Test S3 Input"
		}
	],
	"outputs": [
		{
			"key": "origin",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucket": "sample-output-bucket",
			"name": "Test S3 Output"
		}
	],
	"ingest": [
		{
			"key": "video",
			"inputKey": "main",
			"inputPath": "<INSERT YOUR INPUT PATH>",
			"selectionMode": "VIDEO_RELATIVE",
			"position": 0
		},
		{
			"key": "audio",
			"inputKey": "main",
			"inputPath": "<INSERT YOUR INPUT PATH>",
			"selectionMode": "AUDIO_RELATIVE",
			"position": 0
		}
	],
	"filters": [
		{
			"key": "deint",
			"kind": "DEINTERLACE",
			"parity": "AUTO",
			"mode": "FRAME",
			"frameSelectionMode": "ALL",
			"autoEnable": "META_DATA_AND_CONTENT_BASED"
		}
	],
	"renditions": [
		{
			"key": "v1080",
			"codec": "H264",
			"ingestKey": "video",
			"height": 1080,
