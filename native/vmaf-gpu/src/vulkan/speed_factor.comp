// Adapted from Netflix/vmaf 74f930d17de8c58e7c2ce55e2b897b0030ebd8ef
// feature/speed.c. Small matrix intermediates stay in workgroup memory.
#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 2, std430) buffer Workspace { precise float global_values[]; };
layout(push_constant) uniform Parameters {
    uint mode, width, height, source_image, destination_image, extra0, extra1, extra2;
} parameters;

// Only this pipeline reserves the 12.5 KiB shared matrix workspace. Image and
// covariance dispatches use a separate pipeline without this allocation.
shared precise float f[3126];
shared uint matrix_error;
#include "speed_matrix.glsl"

uint meta(uint index) { return floatBitsToUint(global_values[index]); }
uint matrix_offset(uint slot, uint field) { return meta(36u + slot * 7u + field); }
void block_copy(int destination, int source, int count) {
    for (int i = int(gl_LocalInvocationIndex); i < count; i += 256) f[destination + i] = f[source + i];
    barrier();
}
void block_multiply(int destination, int x, int y) {
    // Each output retains the CPU's ascending-k binary32 accumulation.
    for (int cell = int(gl_LocalInvocationIndex); cell < 625; cell += 256) {
        int row = cell / 25, column = cell % 25;
        precise float sum = 0.0;
        for (int k = 0; k < 25; ++k) sum += f[x + row * 25 + k] * f[y + k * 25 + column];
        f[destination + cell] = sum;
    }
    barrier();
}
#ifndef BITOVP_SPEED_SCALAR_EIGEN
shared precise float eigen_tau;
shared precise float eigen_alpha;
void cooperative_eigenvalues() {
    const int size = 25, square = 625;
    const int a = square + size, d = a + square, sd = d + size;
    const int v = sd + size, x = v + size;
    int lane = int(gl_LocalInvocationIndex);
    block_copy(a, 0, square);
    for (int column = 0; column < size - 2; ++column) {
        // Norms, Householder divisions and dependent scalar dot products keep
        // their original order. Only independent rows and cells are shared.
        if (lane == 0) eigen_tau = compute_householder_transform(a, column, column + 1, size);
        barrier();
        if (lane > column && lane < size) f[v + lane] = f[a + lane * size + column];
        barrier();
        if (eigen_tau != 0.0) {
            if (lane == 0) {
                f[a + (column + 1) * size + column] = f[v + column + 1];
                f[v + column + 1] = 1.0;
            }
            barrier();
            if (lane > column && lane < size) {
                precise float sum = 0.0;
                for (int j = column + 1; j < size; ++j)
                    sum += eigen_tau * f[a + lane * size + j] * f[v + j];
                f[x + lane] = sum;
            }
            barrier();
            if (lane == 0) {
                precise float dot = tridiagonal_dot_product(x, v, column + 1, size);
                eigen_alpha = round_float(-0.5LF * double(eigen_tau) * double(dot));
            }
            barrier();
            if (lane > column && lane < size) f[x + lane] += eigen_alpha * f[v + lane];
            barrier();
            for (int cell = lane; cell < square; cell += 256) {
                int row = cell / size, col = cell % size;
                if (row > column && col > column)
                    f[a + cell] -= f[x + row] * f[v + col] + f[v + row] * f[x + col];
            }
        }
        // This is unconditional: a zero-tau iteration must finish reading
        // eigen_tau in every warp before lane zero overwrites it next time.
        barrier();
    }
    if (lane < size) f[d + lane] = f[a + lane * size + lane];
    if (lane < size - 1) f[sd + lane] = f[a + (lane + 1) * size + lane];
    barrier();
    if (lane == 0) compute_eigenvalues_tridiagonal(d, sd, square, size);
}
#endif

void factor() {
    const int size = 25, square = 625;
    const int a = 0, q = square, r = q + square;
    const int tmp1 = r + square, tmp2 = tmp1 + square, norm_value = tmp2 + square;
    int lane = int(gl_LocalInvocationIndex);
    block_copy(tmp2, a, square);
    for (int cell = lane; cell < square; cell += 256) f[q + cell] = cell / size == cell % size ? 1.0 : 0.0;
    barrier();
    for (int k = 0; k < size - 1; ++k) {
        for (int cell = lane; cell < square; cell += 256) {
            int i = cell / size, j = cell % size;
            if (i < k || j < k) f[tmp2 + cell] = i == j ? 1.0 : 0.0;
        }
        barrier();
        if (lane < size) f[r + lane] = f[tmp2 + lane * size + k];
        barrier();
        if (lane == 0) {
            precise float norm = vector_norm(r, size);
            f[r + k] += get_sign(f[a + k * size + k]) * norm;
            f[norm_value] = vector_norm(r, size);
        }
        barrier();
        if (lane < size) f[r + lane] = cpu_div(f[r + lane], f[norm_value]);
        barrier();
        for (int cell = lane; cell < square; cell += 256) {
            int i = cell / size, j = cell % size;
            precise float value = -2.0 * f[r + i] * f[r + j];
            if (i == j) value += 1.0;
            f[tmp1 + cell] = value;
        }
        barrier();
        block_multiply(r, tmp1, tmp2);
        block_copy(tmp2, r, square);
        block_multiply(r, tmp1, q);
        block_copy(q, r, square);
    }
    block_multiply(r, q, a);
}
void main() {
    const int size = 25, square = 625, q = square, r = q + square;
    int lane = int(gl_LocalInvocationIndex);
    uint slot = gl_WorkGroupID.x;
    int covariance = int(matrix_offset(slot, 0u)), eigenvalues = int(matrix_offset(slot, 1u));
    int temporary = int(matrix_offset(slot, 4u));
    uint output_base = matrix_offset(slot, 5u);
    for (int i = lane; i < square; i += 256) f[i] = global_values[covariance + i];
    barrier();
#ifdef BITOVP_SPEED_SCALAR_EIGEN
    if (lane == 0) compute_eigenvalues(0, square, size, square + size);
#else
    cooperative_eigenvalues();
#endif
    if (lane == 0) {
        matrix_error = 0u;
        for (int i = 0; i < size; ++i)
            if (f[square + i] < EIGENVALUE_EPS) { matrix_error = 1u; break; }
    }
    barrier();
    if (lane < size) {
        precise float value = f[square + lane];
        global_values[eigenvalues + lane] = value;
        global_values[output_base + uint(lane)] = value;
    }
    barrier();
    if (matrix_error == 0u) {
        factor();
        if (lane == 0)
            for (int i = size - 1; i >= 0; --i)
                if (abs(f[r + i * size + i]) < EIGENVALUE_EPS) { matrix_error = 1u; break; }
        for (int i = lane; i < 2 * square; i += 256) global_values[temporary + q + i] = f[q + i];
    }
    if (lane == 0) {
        global_values[matrix_offset(slot, 6u)] = uintBitsToFloat(matrix_error);
        global_values[output_base + 25u + (meta(6) / 5u) * (meta(7) / 5u)] = matrix_error != 0u ? 1.0 : 0.0;
    }
}
