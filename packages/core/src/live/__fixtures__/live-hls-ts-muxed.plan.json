{
	"planVersion": 1,
	"name": "Live HLS with audio muxed into each TS variant (live-hls-ts-muxed)",
	"bitmovin": {
		"cloudRegion": "AWS_AP_NORTHEAST_1",
		"encoderVersion": "STABLE"
	},
	"liveInput": {
		"key": "main",
		"kind": "RTMP"
	},
	"outputs": [
		{
			"key": "origin",
			"kind": "S3",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucket": "sample-output-bucket",
			"name": "Test S3 Output"
		}
	],
	"ingest": [
		{
			"key": "video",
			"inputPath": "live",
			"position": 0
		},
		{
			"key": "audio",
			"inputPath": "live",
			"position": 1
		}
	],
	"renditions": [
		{
			"key": "v540",
			"codec": "H264",
			"name": "Live H264 540p",
			"ingestKey": "video",
			"height": 540,
			"bitrate": 1500000,
			"level": null,
			"presetConfiguration": "LIVE_STANDARD",
			"mode": "STANDARD"
		},
		{
			"key": "v720",
			"codec": "H264",
			"name": "Live H264 720p",
			"ingestKey": "video",
			"height": 720,
			"bitrate": 3000000,
			"level": null,
			"presetConfiguration": "LIVE_STANDARD",
			"mode": "STANDARD"
		},
		{
			"key": "a128",
			"codec": "AAC",
			"ingestKey": "audio",
			"bitrate": 128000,
			"rate": 48000,
			"channelLayout": "CL_STEREO"
		}
	],
	"muxings": [
		{
			"key": "v540",
			"kind": "TS",
			"streamKey": "v540",
			"additionalStreamKeys": ["a128"],
			"segmentLength": 6,
			"segmentNaming": "seg_%number%.ts",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-hls-ts-muxed/video/540p"
			}
		},
		{
			"key": "v720",
			"kind": "TS",
			"streamKey": "v720",
			"additionalStreamKeys": ["a128"],
			"segmentLength": 6,
			"segmentNaming": "seg_%number%.ts",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-hls-ts-muxed/video/720p"
			}
		}
	],
	"liveManifests": [
		{
			"key": "hls",
			"kind": "HLS",
			"manifestName": "stream.m3u8",
			"name": "Live HLS Manifest",
			"destination": {
				"outputKey": "origin",
				"path": "output/live-hls-ts-muxed"
			},
			"audioGroupId": "audio",
			"audioLanguage": "en",
			"closedCaptions": "NONE",
			"timeshift": 7200
		}
	],
	"start": {
		"streamKey": "muxedLive"
	}
}
