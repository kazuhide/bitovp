{
	"planVersion": 1,
	"name": "generic-s3-akamai-io",
	"bitmovin": {
		"cloudRegion": "AWS_AP_NORTHEAST_1",
		"encoderVersion": "STABLE"
	},
	"inputs": [
		{
			"key": "main",
			"kind": "GENERIC_S3",
			"credentialId": "00000000-0000-4000-8000-000000000001",
			"bucket": "akamai-input-bucket",
			"name": "Akamai Generic S3 Input"
		}
	],
	"outputs": [
		{
			"key": "origin",
			"kind": "GENERIC_S3",
			"credentialId": "00000000-0000-4000-8000-000000000002",
			"bucket": "akamai-output-bucket",
			"name": "Akamai Generic S3 Output"
		}
	],
	"ingest": [
		{
			"key": "video",
			"inputKey": "main",
			"inputPath": "sintel/Sintel.2010.1080p.mkv",
			"selectionMode": "VIDEO_RELATIVE",
			"position": 0
		},
		{
			"key": "audio",
			"inputKey": "main",
			"inputPath": "sintel/Sintel.2010.1080p.mkv",
			"selectionMode": "AUDIO_RELATIVE",
			"position": 0
		}
	],
	"renditions": [
		{
			"key": "v360",
			"codec": "H264",
			"ingestKey": "video",
			"height": 360,
			"bitrate": 300000,
			"level": null,
			"presetConfiguration": "VOD_HIGH_QUALITY",
			"mode": "STANDARD"
		},
		{
			"key": "a128",
			"codec": "AAC",
			"ingestKey": "audio",
			"bitrate": 128000,
			"rate": 48000,
			"channelLayout": "CL_STEREO"
		}
	],
	"muxings": [
		{
			"key": "v360",
			"kind": "FMP4",
			"streamKey": "v360",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/generic-s3-akamai-io/video/360p",
				"acl": "PUBLIC_READ"
			}
		},
		{
			"key": "a128",
			"kind": "FMP4",
			"streamKey": "a128",
			"segmentLength": 6,
			"segmentNaming": "segment_%number%.m4s",
			"initSegmentName": "init.mp4",
			"destination": {
				"outputKey": "origin",
				"path": "output/generic-s3-akamai-io/audio/128000",
				"acl": "PUBLIC_READ"
			}
		}
	],
	"manifests": [
		{
			"key": "hls",
			"kind": "HLS",
			"manifestName": "stream.m3u8",
			"name": "HLS Manifest",
			"destination": {
				"outputKey": "origin",
				"path": "output/generic-s3-akamai-io/",
				"acl": "PUBLIC_READ"
			},
			"masterVersion": "HLS_V4",
			"mediaVersion": "HLS_V4",
			"audioGroupId": "audio",
			"audioLanguage": "en",
			"closedCaptions": "NONE"
		}
	],
	"generation": {
		"timing": "JUST_IN_TIME"
	}
}
