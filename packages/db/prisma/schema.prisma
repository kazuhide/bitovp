/// Bearer machine credentials (ledger #81, docs/API-USAGE.md). The secret
/// is `bo_` + 43 base64url chars (32 random bytes), stored ONLY as a SHA-256
/// hex — not scrypt: the secret is 256-bit random, so a KDF adds per-request
/// latency without security. Soft revoke keeps rows for audit trails.
model ApiToken {
  userId String? @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id         String    @id @default(uuid()) @db.Uuid
  name       String
  /// First 8 chars after "bo_" — display/lookup key. NOT secret.
  prefix     String    @unique
  tokenHash  String
  role       String    @default("OPERATOR")
  /// user:<id> once multi-user lands; null until then.
  createdBy  String?
  expiresAt  DateTime?
  revokedAt  DateTime?
  /// Best-effort observability; throttled in-process (≤1 write/min/token).
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Live schedule statuses.
enum LiveScheduleStatus {
  ARMED
  FIRED
  COMPLETED
  CANCELED
  MISSED
  ERROR
  /// Row #241: the row was armed for a DIFFERENT airing than the one on
  /// the air now, so it was refused rather than fired. Terminal, and not an
  /// ERROR — nothing malfunctioned; the generation the operator armed
  /// against ended. `note` names both run ids so the refusal is auditable.
  SKIPPED_STALE_GENERATION
}

/// What a schedule row DELIVERED, which is a different question from whether
/// it fired. `status = FIRED` says only "the request left this system"; a
/// SLATE_IN request may fire while the provider's scheduled entry goes ERROR
/// and the picture never changes. Delivery therefore gets its own column.
///
/// The first cut of this column collapsed the middle: it wrote `DELIVERED` the
/// instant a feeder's ffmpeg started pushing (~16s before the provider bound
/// the ingest) and the instant a slate's provider entry was ARMED (no
/// segment/frame witness that it aired). "Delivered" was thus claimed
/// before any media flowed. The states below split that single leap into the
/// media progression, so a green means media was OBSERVED, not
/// merely requested:
///
///   PENDING          — a writer is still expected (the job that fired it runs).
///   PROCESS_PUSHING  — our feeder's ffmpeg is pushing bytes, but the provider
///                      has NOT confirmed it received them. Not a success.
///   INGEST_CONNECTED — the provider's live encoder reports a fresh CONNECTED
///                      ingest while we push: the media reached the provider.
///                      This is the strongest witness the app holds for a feed
///                      (there is no output frame-probe), so it is the feeder's
///                      terminal-positive green.
///   SLATE_ARMED      — the provider ARMED a scheduled insertion. The SDK has
///                      no played/finished status, so this is NOT a witness the
///                      slate aired — it stays short of a green.
///   DELIVERED        — a lifecycle action reached its terminal positive: a
///                      START whose channel reached RUNNING, or a STOP observed
///                      terminal. Green.
///   FAILED           — a definitive non-delivery. STICKY: a later, weaker
///                      observation must not un-fail a feed that died.
///   UNKNOWN          — nobody will ever tell us: the deadline passed, the job
///                      died, or the row fired before this column existed. A
///                      later positive observation must NOT upgrade it
///                      (a manual START hours later must not
///                      relabel a past UNKNOWN as DELIVERED).
///
/// PENDING / UNKNOWN / PROCESS_PUSHING / SLATE_ARMED all render amber-or-neutral
/// (unconfirmed); only INGEST_CONNECTED and DELIVERED render green. The reader
/// (`schedule-panel.tsx`) and the precedence writer (`schedule-outcome.ts`) are
/// the two authorities and a test set-equals the enum against them.
enum LiveScheduleOutcome {
  PENDING
  PROCESS_PUSHING
  INGEST_CONNECTED
  SLATE_ARMED
  DELIVERED
  FAILED
  UNKNOWN
}

/// START provisions; STOP always stops, even when late.
/// SLATE_IN schedules insertable content over the stream
/// (start-like grace: a slate fired late into a program is worse than a
/// missed slate).
enum LiveScheduleAction {
  START
  STOP
  SLATE_IN
  FEEDER_START
  FEEDER_SWITCH
}

/// Durable state at the external-effect boundary.
/// DISPATCHING means the intent is committed and the request/process may have
/// been sent; a timeout or owner loss moves it to AMBIGUOUS, never back to a
/// retryable empty slot without exact readback.
enum LiveEffectClaimState {
  CLAIMED
  DISPATCHING
  ACKED
  FAILED
  AMBIGUOUS
  RESOLVED
}

/// Why a schedule outcome may be trusted. The version is
/// stored separately so a future evidence contract can fail closed without
/// relabelling rows written under this one.
enum LiveScheduleOutcomeEvidenceKind {
  PROVIDER_RUNNING
  PROVIDER_TERMINAL
  PROVIDER_STATUS_UNKNOWN
  HEARTBEAT_INGEST_CONNECTED
  FEEDER_PROCESS_PUSHING
  SLATE_ARMED
  EFFECT_FAILED
  JOB_TERMINAL_UNKNOWN
  STALE_GENERATION_REFUSAL
}

/// Ledger #160 PR1 — one row per RUN start attempt (per-run: #108).
/// queueSeconds = the AWAIT pair (Bitmovin's allocation time isolated);
/// totalSeconds = end-to-end from the first step. cloudRegion is the
/// RESOLVED region (infrastructure.cloudRegion ?? plan region; AUTO stays
/// its own honest bucket). One sample per run: the success writer UPSERTS
/// over a reconciler's provisional FAILED row.
enum StartupSampleSource {
  CHANNEL
  PROBE
}

enum StartupOutcome {
  RUNNING
  FAILED
  CENSORED
}

model StartupSample {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                String              @id @default(uuid()) @db.Uuid
  cloudRegion       String
  infrastructureId  String?
  bitmovinAccountId String?
  source            StartupSampleSource
  outcome           StartupOutcome
  failedPhase       String?
  queueSeconds      Int?
  totalSeconds      Int?
  encoderVersion    String?
  /// Ledger #160 PR4: a probe's post-run cleanup failure is recorded ON the
  /// sample (design §4) — the measurement stands, the leftover is named.
  cleanupError      String?
  /// Provenance, NOT a relation — deliberately no FK: samples are REGION
  /// statistics and must survive their channel/run being deleted (deleting
  /// a test channel must not erase the region's history). Unique so the
  /// success upsert and the failure create-if-absent converge per run.
  liveChannelRunId  String?             @unique @db.Uuid
  poolAcquired      Boolean             @default(false)
  observedAt        DateTime            @default(now())

  @@index([cloudRegion, source, observedAt(sort: Desc)])

  @@unique([organizationId, id])
  @@index([organizationId])
}

model LiveSchedule {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                    String              @id @default(uuid()) @db.Uuid
  liveChannelId         String              @db.Uuid
  liveChannel           LiveChannel         @relation(fields: [liveChannelId], references: [id], onDelete: Cascade)
  /// Row #241 — WHICH AIRING this row was armed for (audit 2026-08-29
  /// HIGH-4). A schedule bound only to the channel outlives the run it was
  /// meant for: after a re-air, a STOP armed for last night's programme
  /// could take today's off the air, and a slate or feeder armed for run N
  /// could push its content into run N+1. The sweep compares this against
  /// the channel's current run before it fires and refuses a mismatch as
  /// `SKIPPED_STALE_GENERATION`.
  ///
  /// NULL = armed before any run existed (creation-time rows; a channel not
  /// yet provisioned). Those keep today's behaviour and bind LAZILY, to the
  /// run that is current when they first fire — see `bindGeneration` in
  /// `apps/worker/src/scheduler/sweep.ts`.
  ///
  /// Provenance, NOT a relation — deliberately no FK, for the same reason
  /// `feederSessionId` below and `StartupSample.liveChannelRunId` have none:
  /// the schedule LEDGER must be able to outlive the run it names.
  liveChannelRunId      String?             @db.Uuid
  action                LiveScheduleAction
  /// Wall-clock fire time, UTC.
  fireAt                DateTime
  /// Ledger #160 PR3: fireAt was RESOLVED from airAt − lead at arm time
  /// (P90 + margin, or the default lead below the honesty bar). The sweep
  /// derives this row's MISSED deadline from airAt instead of fireAt — an
  /// early fire time must not shrink the useful window (design §5).
  autoLeadTime          Boolean             @default(false)
  /// Ledger #160 PR2 (START rows only): the intended AIR time. When set,
  /// the sweep raises SCHEDULE_NOT_RUNNING_AT_DEADLINE if the channel is
  /// not RUNNING by airAt − deadlineMarginSeconds — the #94-F11 gap, one
  /// alert instead of two surfaces. PR3's auto-lead resolves fireAt FROM
  /// this value; a null airAt means no deadline monitoring.
  airAt                 DateTime?
  deadlineMarginSeconds Int                 @default(300)
  /// Dedup stamp: the deadline event fires once per row.
  deadlineNotifiedAt    DateTime?
  /// SLATE_IN only: the registered insertable-content id + play length.
  insertableContentId   String?
  slateDurationSeconds  Int?
  /// Creation-time slate (ledger #94): the CLIP SOURCE, because insertable
  /// content is per-encoding and no encoding exists at creation. The worker
  /// registers it once the channel is RUNNING and only then fills
  /// insertableContentId — which is also the fire path's READY gate.
  slateSource           Json?
  /// Slate insertion upper bound: fire-time duration = slateUntil − now. A duration
  /// fixed at arm time would overrun into the program by however late
  /// provisioning ran.
  slateUntil            DateTime?
  /// Registration CAS claim — two sweep ticks must not register twice.
  contentClaimedAt      DateTime?
  /// Ledger #96: the file a scheduled FEEDER row pushes ({credentialId, bucket, key}).
  feederSource          Json?
  status                LiveScheduleStatus  @default(ARMED)
  firedAt               DateTime?
  /// Ledger #236 — the queue-handoff OUTBOX stamp (audit 2026-08-29
  /// CRITICAL-1). The sweep used to write the claim (row FIRED, and for a
  /// STOP the channel STOPPING) and only THEN call `queue.add`; a SIGKILL
  /// between the two lost the action forever, because the next sweep reads
  /// only ARMED rows. A FIRED row now means CLAIMED, and `dispatchedAt`
  /// means HANDED TO THE QUEUE — it is written only after `add` resolves.
  /// FIRED + null is therefore the recoverable state the dispatcher pass
  /// re-adds (under the same deterministic job id, so a handoff that DID
  /// land dedupes instead of running twice).
  dispatchedAt          DateTime?
  /// The BullMQ job id the handoff used. Forensics only — never the
  /// re-dispatch INPUT, because a crash leaves it null by construction; the
  /// dispatcher always DERIVES the id from the row id.
  dispatchJobId         String?
  note                  String?
  error                 String?
  /// Ledger #238: did the fired action actually land? Written by whoever
  /// LEARNS the answer — the slate poll, the feeder session's own status
  /// transitions, the stop confirmation, the dead-job handler — never by the
  /// enqueue. FAILED is sticky: a later success must not un-fail a row.
  outcome               LiveScheduleOutcome @default(PENDING)
  outcomeAt             DateTime?
  outcomeNote           String?
  /// SC-02: green is allowed only for the current evidence contract. Null is
  /// legacy/unverified and therefore amber even if an old row says DELIVERED.
  outcomeEvidenceVersion Int?
  outcomeEvidenceKind    LiveScheduleOutcomeEvidenceKind?
  outcomeEvidenceAt      DateTime?
  /// FEEDER_START / FEEDER_SWITCH: the session this row created. Provenance,
  /// NOT a relation — deliberately no FK, so the feeder session can be
  /// deleted (the DELETE route exists) without taking the schedule ledger's
  /// history with it, and so the outcome writer can find its row by a single
  /// reverse lookup instead of threading the id through the queue payload.
  feederSessionId       String?             @db.Uuid
  /// Row #240 — a FEEDER_SWITCH row's own outbox pair for the PRE-STAGE
  /// (audit 2026-08-29 HIGH-3). `stagedAt` is the sweep's claim at
  /// fireAt − lead (the row stays ARMED — staging is not firing);
  /// `stageDispatchedAt` is written only after the stage job's `queue.add`
  /// resolved, so a crash between the two is a claim with no handoff that the
  /// dispatcher pass re-adds under the same deterministic job id — the same
  /// shape `firedAt`/`dispatchedAt` give the fire itself. `readyAt` is a
  /// write-once RECORD mirrored from the session when its staging completed;
  /// the sweep's commit gate reads the SESSION, which is the live truth (a
  /// takeover re-stages it). `switchSeamMs` is the measured seam, mirrored
  /// from the session at its first push.
  stagedAt              DateTime?
  stageDispatchedAt     DateTime?
  readyAt               DateTime?
  switchSeamMs          Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status, fireAt])
  @@index([liveChannelId])
  /// "Every row armed for this run" — the lazy bind pass reads it, and so
  /// does anyone auditing which airing a refused row belonged to (row #241).
  @@index([liveChannelRunId])
  /// The dispatcher's scan: FIRED rows with no handoff stamp. FIRED rows
  /// accumulate for the life of a channel, so the scan needs its own index
  /// rather than riding [status, fireAt].
  @@index([status, dispatchedAt])
  @@index([feederSessionId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Row #330 — slate normalization + registration for the DIRECT route.
/// A movie slate registered from the channel page is no longer handed to the
/// provider as it is: the worker transcodes it to an MPEG-TS that matches
/// the live ingest (measured 2026-09-12/13: MP4/MOV audio plays at half
/// speed, mono/yuv422p/MKV pass every preflight and fail on air, a frame-rate
/// mismatch plays fast and ends black). This row is the operator's view of
/// that work — waiting for the input, converting, registering, ready, or the
/// reason it failed. A scheduled (creation-time) slate keeps its own path on
/// `LiveSchedule` and shares the worker's preparer, not this table.
enum SlateNormalizationStatus {
  /// The channel has no ingest reference yet; the promoter re-queues the row
  /// once a heartbeat with stream attributes exists.
  WAITING_FOR_INPUT
  QUEUED
  NORMALIZING
  REGISTERING
  READY
  ERROR
}

model SlateNormalization {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                  String                   @id @default(uuid()) @db.Uuid
  liveChannelId       String                   @db.Uuid
  liveChannel         LiveChannel              @relation(fields: [liveChannelId], references: [id], onDelete: Cascade)
  bitmovinAccountId   String                   @db.Uuid
  /// The operator's content name (optional) — becomes the provider content's name.
  name                String?
  /// The source triple, exactly as the picker chose it (the credential is a REFERENCE).
  credentialId        String                   @db.Uuid
  bucket              String
  sourceKey           String
  status              SlateNormalizationStatus @default(QUEUED)
  /// The ingest attributes the file was matched to (`SlateNormalizationTarget`), once known.
  target              Json?
  /// Why the row is where it is — the preparer's plain-English reason (localized by code in the panel).
  note                String?
  error               String?
  /// The object the provider was pointed at: the source itself (as-is) or the normalized MPEG-TS.
  registeredKey       String?
  /// Its bucket when it is not the source's (the channel's S3-family output, #330 follow-up); null = `bucket`.
  registeredBucket    String?
  normalized          Boolean                  @default(false)
  /// Provider content id once READY at the provider — what the schedule form needs.
  insertableContentId String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([liveChannelId, status])
  /// The promoter's scan: WAITING_FOR_INPUT rows across channels, oldest first.
  @@index([status, updatedAt])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// One durable intent per idempotency key. Run ids are
/// provenance rather than foreign keys: claims must survive historical run
/// cleanup long enough to explain an ambiguous provider/process effect.
model LiveEffectClaim {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                    String               @id @default(uuid()) @db.Uuid
  liveChannelId         String               @db.Uuid
  liveChannel           LiveChannel          @relation(fields: [liveChannelId], references: [id], onDelete: Cascade)
  liveChannelRunId      String               @db.Uuid
  scheduleId            String?              @db.Uuid
  action                String
  idempotencyKey        String               @unique
  requestSha256         String?
  providerResultId      String?
  providerEncodingId    String
  targetId              String?
  generation            Int
  state                 LiveEffectClaimState @default(CLAIMED)
  token                 String               @unique @db.Uuid
  attempt               Int                  @default(1)
  ownerId               String
  expiresAt             DateTime
  dispatchedAt          DateTime?
  acknowledgedAt        DateTime?
  failure               String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([liveChannelId, state])
  @@index([scheduleId])
  @@index([state, expiresAt])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Watch folder rule (ledger #87): a bucket prefix we LIST (never write)
/// on the customer's own storage; stable new objects auto-submit encoding
/// jobs from the FULL_PLAN preset. Restrict FKs: deleting a credential or
/// preset with live rules must be a deliberate act.
model WatchRule {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                   String     @id @default(uuid()) @db.Uuid
  name                 String
  credentialId         String     @db.Uuid
  credential           Credential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  bucket               String
  prefix               String     @default("")
  /// Lowercased extension allowlist, e.g. ["mp4","mov"]. Empty = all.
  extensions           String[]   @default([])
  presetId             String     @db.Uuid
  preset               Preset     @relation(fields: [presetId], references: [id], onDelete: Restrict)
  /// Output path template: {basename} {ext} {date} {uuid} {rule}.
  outputPrefixTemplate String
  labels               String[]   @default([])
  enabled              Boolean    @default(true)
  /// Ledger #132: set when the data reset disarmed this rule. The reset
  /// deletes WatchedObject — the at-most-once memory — so re-enabling
  /// re-detects EVERYTHING under the prefix as new and submits billable
  /// encodings. "Zero watched objects" cannot distinguish this from a
  /// freshly created rule (where full detection is the intended first
  /// sweep); the distinction IS this stamp. Cleared only by an enable that
  /// explicitly acknowledged the re-detection (PATCH guard).
  disarmedByResetAt    DateTime?
  pollIntervalSec      Int        @default(120)
  /// Consecutive identical sightings before submission ("still being
  /// written" guard).
  stabilityChecks      Int        @default(2)
  maxConcurrentJobs    Int        @default(3)
  /// Bounded-pages resume cursor (searchObjects honesty rule: a partial
  /// sweep says so and resumes here next tick). Beyond the design doc.
  scanCursor           String?
  /// Consecutive failed sweeps — drives the exponential backoff (cap 15
  /// min). Beyond the design doc, which named the behavior not the column.
  errorStreak          Int        @default(0)
  lastSweepAt          DateTime?
  lastError            String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  objects WatchedObject[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@unique([organizationId, name])
}

enum WatchedObjectState {
  SEEN
  STABLE
  SUBMITTED
  SKIPPED
  ERROR
}

/// Per-object tracking (ledger #87). contentId = size:mtime (our storage
/// contract surfaces no etag): a RE-UPLOADED object gets a NEW row (the
/// unique key re-arms it) while a re-listed unchanged object can never
/// double-submit — DB-enforced (#14 precedent).
model WatchedObject {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id            String             @id @default(uuid()) @db.Uuid
  watchRuleId   String             @db.Uuid
  watchRule     WatchRule          @relation(fields: [watchRuleId], references: [id], onDelete: Cascade)
  objectKey     String
  contentId     String
  state         WatchedObjectState @default(SEEN)
  size          BigInt?
  mtimeMs       Float?
  stableCount   Int                @default(0)
  encodingJobId String?            @db.Uuid
  encodingJob   EncodingJob?       @relation(fields: [encodingJobId], references: [id], onDelete: SetNull)
  error         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([watchRuleId, objectKey, contentId])
  @@index([watchRuleId, state])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// per-user accounts for AUTH_MODE=users.
enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Normalized at WRITE and LOOKUP: lowercase + trim (one shared helper) —
  /// `Admin@x.com` and `admin@x.com` must be one account, not two.
  email              String    @unique
  displayName        String
  /// scrypt$N$r$p$salt$hash — SAME format and parser as AUTH_PASSWORD_HASH.
  passwordHash       String
  role               UserRole  @default(OPERATOR)
  active             Boolean   @default(true)
  /// Forced-rotate flag (bootstrap / admin reset). Enforced by the GATE:
  /// while true, only change-password and logout continue (§3c).
  mustChangePassword Boolean   @default(false)
  /// Temp-password TTL (§3c, ~72h from issuance). Expired ⇒ a distinct
  /// "ask an admin to reissue" login response (caller already proved the
  /// password, so distinguishing is safe).
  passwordExpiresAt  DateTime?
  /// Session watermark: cookies with iat at or before this are invalid.
  /// Bumped on password change, admin reset, and role change.
  sessionsValidFrom  DateTime  @default(now())
  /// Monotonic revocation generation. A users-mode cookie carries the exact
  /// generation whose password was verified; the gate requires equality.
  /// Unlike a millisecond timestamp this cannot alias two concurrent resets.
  sessionGeneration  Int       @default(0)
  /// OIDC seam (#31): subject claim once oidc mode exists.
  oidcSubject        String?   @unique
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  platformOwner Boolean @default(false)
  memberships Membership[]
  accessEvents AccessEvent[]
  apiTokens ApiToken[]
}

/// First-boot setup code (§3c). A DB row, NOT process memory: the akamai
/// profile runs TWO web processes against one DB — an in-memory code minted
/// by one process could never be verified by the other. Holds the SHA-256 of
/// the code; the plaintext is printed to stdout once and never stored.
model SetupCode {
  id        String    @id @default(uuid()) @db.Uuid
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// One paid verification run, durably. Re-audit 2026-08-29 HIGH-7 / GO 11:
/// the harness already proved provider-terminal cleanup, a known commit, the
/// source's bytes and a sealed report — but every one of those facts lived in
/// `verify-runs/<runId>/` on the operator's disk and in a terminal scrollback,
/// so release evidence could not be reconstructed from the Dashboard once the
/// session ended. This row is the join: run → provider account → source bytes
/// → per-scenario verdicts (VMAF and delivery checks included) → cleanup seal.
///
/// It holds NO secrets. `baseUrlOrigin` is an origin, never the token or the
/// password that rode on it; `actor` is the AuditLog convention (`token:<id>`),
/// which is what lets a run join its own audit rows.
model VerificationRun {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id String @id @default(uuid()) @db.Uuid

  /// The harness's own run id (`verify-runs/<runId>`) — and the RESERVATION.
  /// Unique, created before anything is spent: `prepareRunDir` refuses a reused
  /// id on ONE host's disk, and this refuses it across every host that shares
  /// the database (re-audit GO 4).
  runId String @unique

  /// VOD | LIVE | MIXED (core's VerificationRunKind), derived from the
  /// scenarios the run selected. Null until that set is known — a run that
  /// dies in preflight never had a kind, and naming one would be a guess.
  kind String?

  /// RUNNING | SEALED | INCOMPLETE (core's VerificationRunStatus). A row left
  /// RUNNING is not a gap in this model: it is the evidence that the run never
  /// sealed a report — and that reading is only worth making because the seal
  /// write RETRIES first (SEAL_WRITE_ATTEMPTS in the worker's run-record.ts).
  /// Without the retry a single transient write failure would leave this
  /// column saying "never sealed" about a run that sealed perfectly, which is
  /// the same class of untrustworthy evidence this table exists to end.
  status String @default("RUNNING")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// The run report's fingerprint. Defaulted to the same
  /// word `collectRunFingerprint` itself uses, because the reservation is
  /// written BEFORE the fingerprint is collected — nothing is spent in that
  /// window, and "unknown" is what a row that died inside it truthfully says.
  commit                  String  @default("unknown")
  checkoutLatestMigration String  @default("unknown")
  dbLatestMigration       String  @default("unknown")
  drift                   Boolean @default(false)

  /// The account the run BILLED. SetNull, not Cascade: deleting an account
  /// must not delete the evidence of what it was charged for.
  bitmovinAccountId String?          @db.Uuid
  bitmovinAccount   BitmovinAccount? @relation(fields: [bitmovinAccountId], references: [id], onDelete: SetNull)

  /// Origin only (scheme://host:port) — never a path, a query or a credential.
  baseUrlOrigin String?
  /// `token:<id>`, resolved from the runner's own API token, so the run joins
  /// AuditLog.actor. The token itself is never stored, hashed or otherwise.
  actor         String?

  /// The staged mezzanine every scenario reads, and its version identity
  /// (etag/versionId/size) — a NAME says nothing about bytes.
  sourceObject   String?
  sourceIdentity String?

  /// The prior SEALED run whose PASSes this one honoured (`--resume-from`).
  /// This is a real self-relation, not a free-form run-id string: a resumed
  /// PASS was not re-spent, so the evidence authority lives in THAT row.
  resumedFromId String?          @db.Uuid
  resumedFrom   VerificationRun? @relation("VerificationRunResume", fields: [resumedFromId], references: [id], onDelete: SetNull)
  resumedRuns   VerificationRun[] @relation("VerificationRunResume")

  /// The pre-spend resume decision (accepted or refused), including the
  /// compared digests, algorithm/key id and retention deadline. Never a key.
  resumeDecision Json?

  /// ScenarioOutcome[] — every field the report carries, per scenario
  /// (verdict, reason, jobId, encodingId, check counts, planSha256, the
  /// source it read, the account it billed). Written as each scenario
  /// finishes, so a crash mid-run leaves partial evidence rather than none.
  outcomes Json @default("[]")
  /// Record<ScenarioVerdict, number>.
  counts   Json @default("{}")

  /// encodingId → the PROVIDER's status at cleanup time, exactly what
  /// `ensureTerminal` read through the worker's own SDK.
  providerReadback Json?
  /// Per-scenario cleanup: { scenario, jobId, status, cancelHttp, terminal,
  /// localTerminal, providerTerminal, encodingIds }. `ensureTerminal` runs
  /// once per ABANDONED job, so this is an array, not one run-level verdict.
  cleanup          Json?

  /// The database is the release authority: SEALED stores the exact bytes
  /// covered by `seal` in the same row update. `reportPath` names a recoverable
  /// local export only; a file or file-side seal is never authoritative alone.
  reportPath     String
  reportJson     String? @db.Text
  reportMarkdown String? @db.Text
  reportSha256   String?
  seal           String?
  /// SHA256 is local corruption detection only; HMAC_SHA256 is release-grade.
  sealAlgorithm String?
  /// Identifier used to select a key from the runtime keyring. No key material.
  sealKeyId String?
  /// Version of the joined DB/file/scenario evidence contract.
  evidenceVersion Int?
  /// Hashes of every PASS scenario's retained plan and scenario report.
  evidenceManifest Json?
  /// Resume is refused at or after this instant; the row remains as a tombstone.
  retentionUntil DateTime?
  sealedAt     DateTime?

  /// Why an INCOMPLETE run ended — redacted and truncated.
  error String?

  /// Run-level restart fence. A producer may create/transition paid-resource
  /// intents or SEALED-CAS only the generation it reserved. Explicit recovery
  /// increments this generation and leases the run before touching child
  /// intents, so a merely slow producer cannot submit or publish success after
  /// an operator has begun teardown.
  recoveryOwner      String?
  recoveryLeaseUntil DateTime?
  recoveryGeneration Int       @default(0)

  /// EV-01: every paid resource this run INTENDED to create, written before
  /// the create was sent. The seal reads these, not the in-memory ids.
  intents VerificationResourceIntent[]
  /// The Live/MSL evidence tuples this run sealed, one per output leg.
  liveEvidence VerificationLiveEvidence[]

  @@index([startedAt(sort: Desc)])
  @@index([bitmovinAccountId])
  @@index([resumedFromId])
  @@index([retentionUntil])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// The durable INTENT to create one
/// paid resource, committed BEFORE the create request is sent.
///
/// The defect: the harness learned a job's or channel's id from the HTTP
/// response. A timeout, a reset or an unparseable body between the server's
/// create and that assignment left nothing in memory for cleanup to act on,
/// while the resource billed. This row is what survives that window: its
/// `verificationKey` is derivable from (run, scenario, kind) with no response
/// at all, the product stamps the same key on the job/channel it creates, and
/// the resource's name/label carries it too — so the set of "resources that
/// MAY have been created" is rediscoverable, and the run's cleanup seal is
/// driven by this set (`verificationIntentsSealable` in core), never by the
/// ids a process happened to still hold.
///
/// Vocabulary in core's `verify/resource-intent.ts` (states, kinds, cleanup
/// states) — plain strings here, the VerificationRun precedent.
model VerificationResourceIntent {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id String @id @default(uuid()) @db.Uuid

  /// Cascade: an intent is a child of its run's evidence row.
  verificationRunId String          @db.Uuid
  verificationRun   VerificationRun @relation(fields: [verificationRunId], references: [id], onDelete: Cascade)

  scenario String
  /// VOD_JOB | LIVE_CHANNEL (core's VerificationIntentKind).
  kind     String

  /// `verify:<runId>:<scenario>:<kind>` — the idempotency key the product
  /// honours (EncodingJob/LiveChannel.verificationKey). Unique: one intent
  /// per paid resource, across every run that shares this database.
  verificationKey String  @unique
  /// SHA-256 of the request body the harness meant to send, recorded before
  /// the send; the product stores the same value beside the key.
  requestSha256   String
  /// The exact `name` the request carried — the resource's second marker.
  /// A VOD job also carries the key as a label; a live channel has only its
  /// name, so a lookup that must work from THIS ROW alone needs it here.
  resourceName    String?

  /// PREPARED | SUBMITTED | CONFIRMED | AMBIGUOUS | TERMINAL.
  state String @default("PREPARED")

  /// The product's id for the resource (EncodingJob.id / LiveChannel.id),
  /// from the response or from the lookup that adopted it.
  localId     String?
  /// The provider's encoding id once known (read back from the local row).
  providerId  String?
  /// Every provider encoding for ladders/multi-encoding jobs. `providerId`
  /// remains the sole/primary compatibility projection.
  providerIds String[] @default([])

  /// What an AMBIGUOUS lookup found: [{ localId, matchedBy[], status,
  /// providerId }]. Kept whatever the count, so an UNRESOLVED intent tells the
  /// operator exactly which rows competed for it.
  candidates Json?

  /// PENDING | CLEANED | NEVER_CREATED | UNRESOLVED.
  cleanupState        String    @default("PENDING")
  /// The terminal readback that closed the intent: local status, provider
  /// statuses, live cleanup seal — whatever the kind's resolver read.
  readback            Json?
  /// Canonical resource identities used by the closure equality gate.
  possiblyCreatedKeys String[]  @default([])
  cleanedResourceKeys String[]  @default([])
  /// SHA-256 over the closure dossier fields; recomputed before run seal.
  closureDigest       String?
  /// When the intent reached TERMINAL.
  sealedAt            DateTime?

  /// Monotonic append-only event sequence and the dispatch/recovery lease. A
  /// crashed process can be resumed without racing an in-flight paid POST or
  /// allowing two reconcilers to act.
  eventSeq           Int                               @default(0)
  recoveryOwner      String?
  recoveryLeaseUntil DateTime?
  recoveryGeneration Int                               @default(0)
  events             VerificationResourceIntentEvent[]

  /// The last fault or refusal, redacted and truncated.
  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationRunId])
  @@index([state])
  @@index([state, recoveryLeaseUntil])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Append-only state/cleanup history for third-party reconstruction of EV-01.
model VerificationResourceIntentEvent {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id String @id @default(uuid()) @db.Uuid

  verificationResourceIntentId String                     @db.Uuid
  verificationResourceIntent   VerificationResourceIntent @relation(fields: [verificationResourceIntentId], references: [id], onDelete: Cascade)

  sequence     Int
  eventType    String
  fromState    String?
  toState      String?
  cleanupState String?
  details      Json?
  createdAt    DateTime @default(now())

  @@unique([verificationResourceIntentId, sequence])
  @@index([createdAt(sort: Desc)])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// One Live / MSL evidence TUPLE.
/// A live PASS used to rest on facts that were never joined: the run row held
/// a channel id, a report and a cleanup seal, but no plan digest, no source
/// identity, no provider resource, no output prefix / edge URL and no media
/// bytes — and the edge closure could close on ZERO segments. This row is the
/// join, per (run, scenario, airing, output leg): `tuple` is core's versioned
/// `LiveEvidenceLeg` (build → source → channel → output → master → children →
/// media → two probes → progression → provider terminal → cleanup), and
/// `complete` is core's single completeness rule over it. The run recorder
/// refuses to write SEALED while a green live outcome has an incomplete leg.
///
/// `liveChannelRunId` is TEXT, not a relation: the evidence must outlive the
/// channel row (a data reset deletes channels; an FK would have to SetNull the
/// very join key the seal is about). Every URL inside `tuple` is credential-
/// free (userinfo dropped, query VALUES dropped, key names + a SHA-256 kept).
model VerificationLiveEvidence {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                String          @id @default(uuid()) @db.Uuid
  verificationRunId String          @db.Uuid
  verificationRun   VerificationRun @relation(fields: [verificationRunId], references: [id], onDelete: Cascade)

  scenario         String
  /// The airing (LiveChannelRun.id), or "unknown" when the channel detail
  /// could not be read — in which case `complete` is false and `missing`
  /// names it; the unique key still needs a value.
  liveChannelRunId String
  /// `<manifestKey>@<outputKey>` — one delivery target of one manifest.
  outputLeg        String

  /// core's LIVE_EVIDENCE_VERSION at write time.
  version  Int
  complete Boolean
  /// string[] — every element the completeness rule found absent.
  missing  Json    @default("[]")
  /// The whole LiveEvidenceLeg, credential-free.
  tuple    Json

  createdAt DateTime @default(now())

  @@unique([verificationRunId, scenario, liveChannelRunId, outputLeg])
  @@index([verificationRunId])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Row #314: which statistics family a usage day belongs to (Bitmovin reports
/// VOD and live encoding statistics through separate daily endpoints).
enum UsageStatisticKind {
  VOD
  LIVE
}

/// Row #314: one day of Bitmovin encoding statistics for one account and one
/// kind, as the provider reported it. Bitmovin deletes encoding statistics 90
/// days after the encoding completes, so the dashboard reads THIS table; the
/// worker's usage sweep refreshes it every few hours and re-reads the trailing
/// days (daily aggregates settle late). `breakdown` keeps the provider's
/// per-day detail (billable minutes per mode/codec/bucket, per-stream codec ×
/// resolution, features, egress by category/region) — a snapshot, because the
/// provider record expires (BITMOVIN-API-COVERAGE invariant 6).
model UsageDailyStatistic {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                String             @id @default(uuid()) @db.Uuid
  bitmovinAccountId String             @db.Uuid
  bitmovinAccount   BitmovinAccount    @relation(fields: [bitmovinAccountId], references: [id], onDelete: Cascade)
  /// The provider's calendar day (UTC).
  date              DateTime           @db.Date
  kind              UsageStatisticKind
  bytesEncoded      Float              @default(0)
  timeEncodedS      Float              @default(0)
  bytesEgress       Float              @default(0)
  /// Encoding (SD/HD/UHD/audio/unknown buckets) + transmuxing + feature minutes.
  billableMinutes   Float              @default(0)
  breakdown         Json               @default("{}")
  fetchedAt         DateTime

  @@unique([bitmovinAccountId, date, kind])
  @@index([date])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Row #314 (rev426 R1): the usage sweep's watermark per account × kind,
/// advanced only after a chunk of that kind was stored — so a failed live
/// read can never hide behind a stored VOD day. No row means "backfill the
/// retention window"; the dashboard derives its freshness note from these
/// rows (the provider omits quiet days, so row presence proves nothing).
model UsageSweepCursor {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id                String             @id @default(uuid()) @db.Uuid
  bitmovinAccountId String             @db.Uuid
  bitmovinAccount   BitmovinAccount    @relation(fields: [bitmovinAccountId], references: [id], onDelete: Cascade)
  kind              UsageStatisticKind
  /// The last provider day (UTC) this kind was read through, inclusive.
  sweptThrough      DateTime           @db.Date
  sweptAt           DateTime

  @@unique([bitmovinAccountId, kind])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Durable paid-resource ownership. Intentionally no cascading FK: reset deletes
/// VmafJob immediately while this receipt survives until cloud cleanup confirms.
model VmafComputeTask {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id            String   @id @default(uuid()) @db.Uuid
  vmafJobId     String   @db.Uuid
  targetKey     String
  profileId     String
  profile       Json
  providerId    String?
  state         String   @default("PREPARING")
  reservedUsd   Float
  stagingKeys   Json     @default("[]")
  receipt       Json?
  expiresAt     DateTime
  queueExpiresAt DateTime
  heartbeatAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  cleanedAt     DateTime?
  error         String?

  attempt       Int      @default(0)
  progress      Json?

  @@unique([vmafJobId, targetKey, attempt])
  @@index([cleanedAt, expiresAt])
  @@index([profileId, cleanedAt])

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Immutable secret versions. Disable only prevents new profile submissions;
/// historical snapshots retain decryption access for cloud teardown.
model VmafComputeCredential {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id String @id @default(uuid()) @db.Uuid
  label String
  provider String
  encryptedSecret String
  disabledAt DateTime?
  createdAt DateTime @default(now())

  @@unique([organizationId, id])
  @@index([organizationId])
}

/// Non-secret named profile. Each submitted task snapshots config and version.
model VmafExecutionProfile {
  organizationId String @default(dbgenerated("(NULLIF(current_setting('bitovp.organization_id', true), '')::uuid)")) @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  id String
  label String
  config Json
  version Int @default(1)
  enabled Boolean @default(true)
  /// Reset tombstones hide customer config while preventing environment fallback resurrection.
  resetAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([organizationId, id])
  @@index([organizationId])
}

